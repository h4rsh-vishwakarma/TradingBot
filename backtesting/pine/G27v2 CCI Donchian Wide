//@version=5
// G27v2 CCI Donchian Wide — Signal-Only Audit Version
// Purpose: honest TV vs Python comparison after Gate 1 FAIL on G27
//
// Root cause of original G27 TV vs Python gap (8–17x):
//   1. strategy.exit() SL 1.5% + TP 15% + Trail 3.5% — forces artificial 10:1 R:R
//      inflating TV WR to 83–85% vs real 28–34% on signal-only
//   2. percent_of_equity=95% compounds position size — incomparable to Python $500 fixed
//   3. Anti-overtrading filter (trades_today, cooldown) reduces TV trade count vs Python
//
// This version: signal-only exits, $500 fixed, no anti-overtrading — matches Python framework
// TV test: AVAX / LINK / SUI / LDO 4H | commission 0.15%
strategy("G27v2 CCI Donchian Wide [Audit]", overlay=true,
     calc_on_every_tick=false, calc_on_order_fills=false,
     initial_capital=10000,
     default_qty_type=strategy.cash, default_qty_value=500,
     commission_type=strategy.commission.percent, commission_value=0.15)

// ── INPUTS ──
dc_len  = input.int(20, "Donchian Length")
dc_exit = input.int(10, "Exit Channel Length")
cci_len = input.int(20, "CCI Length")

// ── DONCHIAN ──
dc_upper   = ta.highest(high, dc_len)
dc_lower   = ta.lowest(low,  dc_len)
exit_lower = ta.lowest(low,  dc_exit)
exit_upper = ta.highest(high, dc_exit)

breakout_up   = close > dc_upper[1]
breakout_down = close < dc_lower[1]

// ── CCI ──
cci           = ta.cci(close, cci_len)
cci_cross_up  = ta.crossover(cci,   100)
cci_cross_down = ta.crossunder(cci, -100)

// ── CONFIRMATION ──
ema50  = ta.ema(close, 50)
[_, _, adx] = ta.dmi(14, 14)
atr14  = ta.atr(14)
atr_ma = ta.sma(atr14, 100)
vol_ok = atr14 < atr_ma * 2
rsi    = ta.rsi(close, 14)

// ── ENTRY ──
long_trigger  = breakout_up   or cci_cross_up
short_trigger = breakout_down or cci_cross_down

long_entry  = long_trigger  and close > ema50 and adx > 18 and vol_ok
short_entry = short_trigger and close < ema50 and adx > 18 and vol_ok

// ── EXIT: signal-only (no SL/TP/trail) ──
long_exit  = close < exit_lower[1] or ta.crossunder(cci, 0) or rsi > 80
short_exit = close > exit_upper[1] or ta.crossover(cci,  0) or rsi < 20

// ── EXECUTION ──
if long_entry and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)
if long_exit and strategy.position_size > 0
    strategy.close("Long")
if short_entry and strategy.position_size >= 0
    strategy.entry("Short", strategy.short)
if short_exit and strategy.position_size < 0
    strategy.close("Short")

plot(dc_upper, "DC Hi",  color.green)
plot(dc_lower, "DC Lo",  color.red)
plot(ema50,    "EMA50",  color.blue, 2)
plot(cci,      "CCI",    color.purple, display=display.pane)
hline(100,  "CCI 100",  color.gray, linestyle=hline.style_dashed)
hline(-100, "CCI -100", color.gray, linestyle=hline.style_dashed)
hline(0,    "CCI 0",    color.new(color.gray, 60), linestyle=hline.style_dotted)
plotshape(long_entry,  "L", shape.triangleup,   location.belowbar, color.lime,  size=size.small)
plotshape(short_entry, "S", shape.triangledown, location.abovebar, color.red,   size=size.small)
