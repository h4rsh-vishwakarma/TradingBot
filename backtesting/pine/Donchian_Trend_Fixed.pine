//@version=5
// Donchian Trend [Webhook] — fixed 2026-05-01
// Fix: trail_pct was double-divided (/100 extra), effective trail was 0.04% not 4%.
//      Removed the extra /100. trail_pct input(4.0) / 100 = 0.04 (4.0%). Correct.
strategy("Donchian Trend [Webhook]", overlay=true, initial_capital=10000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0.06,
     calc_on_order_fills=false, calc_on_every_tick=false, process_orders_on_close=false)

WEBHOOK_SECRET   = "squeeze_tradingview_cluster_2026_secure"
long_alert       = '{"secret":"' + WEBHOOK_SECRET + '","strategy":"Donchian Trend","action":"buy","ticker":"{{ticker}}","interval":"{{interval}}","price":"{{close}}"}'
short_alert      = '{"secret":"' + WEBHOOK_SECRET + '","strategy":"Donchian Trend","action":"sell","ticker":"{{ticker}}","interval":"{{interval}}","price":"{{close}}"}'
close_long_alert = '{"secret":"' + WEBHOOK_SECRET + '","strategy":"Donchian Trend","action":"sell","is_exit":"true","ticker":"{{ticker}}","interval":"{{interval}}","price":"{{close}}"}'
close_short_alert= '{"secret":"' + WEBHOOK_SECRET + '","strategy":"Donchian Trend","action":"buy","is_exit":"true","ticker":"{{ticker}}","interval":"{{interval}}","price":"{{close}}"}'

// ── INPUTS ──
dc_len   = input.int(20,    "Donchian Entry Length")
dc_exit  = input.int(10,    "Donchian Exit Length")
sl_pct   = input.float(2.0, "SL %")    / 100
tp_pct   = input.float(12.0,"TP %")    / 100
trail_pct= input.float(4.0, "Trail %") / 100   // 0.04 = 4.0% — FIXED: no extra /100

// ── DONCHIAN CHANNELS ──
dc_upper   = ta.highest(high, dc_len)
dc_lower   = ta.lowest(low,  dc_len)
exit_upper = ta.highest(high, dc_exit)
exit_lower = ta.lowest(low,  dc_exit)

// ── FILTERS ──
ema50  = ta.ema(close, 50)
[_, _, adx] = ta.dmi(14, 14)

// ── SIGNALS ──
long_entry  = close > dc_upper[1] and close > ema50 and adx > 20
short_entry = close < dc_lower[1] and close < ema50 and adx > 20
long_exit   = close < exit_lower[1]
short_exit  = close > exit_upper[1]

// ── EXECUTION ──
if long_entry
    strategy.entry("L", strategy.long,
         stop=close*(1-sl_pct), limit=close*(1+tp_pct),
         alert_message=long_alert)

if short_entry
    strategy.entry("S", strategy.short,
         stop=close*(1+sl_pct), limit=close*(1-tp_pct),
         alert_message=short_alert)

if long_exit and strategy.position_size > 0
    strategy.close("L", alert_message=close_long_alert)

if short_exit and strategy.position_size < 0
    strategy.close("S", alert_message=close_short_alert)

// ── TRAILING STOP ──
strategy.exit("L_trail", from_entry="L", trail_price=close, trail_offset=close*trail_pct/syminfo.mintick)
strategy.exit("S_trail", from_entry="S", trail_price=close, trail_offset=close*trail_pct/syminfo.mintick)
