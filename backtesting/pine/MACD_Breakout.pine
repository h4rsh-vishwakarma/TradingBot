//@version=5
// MACD_Breakout [Webhook] v2 -- TOURNAMENT MATCHED -- USE ON 15m CHART
// ADX>20 filter + ATR volatility guard + 3-loss cooldown
// FILUSDT Len=13 Mult=2.02 | LDOUSDT Len=13 Mult=2.02 | OPUSDT Len=16 Mult=2.52
strategy("MACD Breakout [Webhook] v2", shorttitle="MB-WH", overlay=false,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.1,
     calc_on_order_fills=false, calc_on_every_tick=false)
macd_len = input.int(13, "MACD Fast Len", minval=5, maxval=30, tooltip="FILUSDT=13, LDOUSDT=13, OPUSDT=16")
atr_mult = input.float(2.02, "Slow Mult", minval=1.0, maxval=5.0, step=0.01, tooltip="FILUSDT=2.02, LDOUSDT=2.02, OPUSDT=2.52")
sl_pct   = input.float(1.0, "Stop Loss %", minval=0.1, maxval=5.0, step=0.1)
tp_pct   = input.float(3.0, "Take Profit %", minval=0.1, maxval=10.0, step=0.1)
adx_th   = input.int(20, "ADX Threshold", minval=10, maxval=40)
slow_len = math.round(macd_len * atr_mult)
[macdLine, signalLine, hist] = ta.macd(close, macd_len, slow_len, 9)
[_, _, adx] = ta.dmi(14, 14)
adxOK    = adx > adx_th
atr14    = ta.atr(14)
atrMa    = ta.sma(atr14, 100)
volOK    = atr14 < 2.0 * atrMa
var int  consec = 0
var int  cdBars = 0
var bool inCool = false
if strategy.closedtrades > 0
    lastPnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    consec  := lastPnl < 0 ? consec + 1 : 0
    if consec >= 3
        inCool := true
        cdBars := 4
        consec := 0
if inCool
    cdBars := cdBars - 1
    if cdBars <= 0
        inCool := false
coolOK    = not inCool
longCond  = ta.crossover(macdLine, 0)  and adxOK and volOK and coolOK
shortCond = ta.crossunder(macdLine, 0) and adxOK and volOK and coolOK
if longCond
    strategy.entry("Long", strategy.long)
if shortCond
    strategy.entry("Short", strategy.short)
strategy.exit("XL", "Long",  loss=close * sl_pct / 100, profit=close * tp_pct / 100)
strategy.exit("XS", "Short", loss=close * sl_pct / 100, profit=close * tp_pct / 100)
plot(macdLine,   "MACD",   color=color.blue)
plot(signalLine, "Signal", color=color.orange)
hline(0, "Zero", color=color.gray)
bgcolor(inCool ? color.new(color.orange, 90) : na, title="Cooldown")
alertcondition(longCond,  "Long Entry",  '{"symbol":"{{ticker}}","action":"buy","strategy":"MACD_Breakout","price":"{{close}}"}')
alertcondition(shortCond, "Short Entry", '{"symbol":"{{ticker}}","action":"sell","strategy":"MACD_Breakout","price":"{{close}}"}')