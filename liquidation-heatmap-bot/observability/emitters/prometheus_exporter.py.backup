"""Enhanced Prometheus exporter with full metric set per spec.

Metrics exposed (all prefixed with liqbot_):

Counters:
- liqbot_decision_total
- liqbot_decision_no_trade_total{reason}
- liqbot_guard_stale_total
- liqbot_guard_edge_total  
- liqbot_veto_context_total{reason}
- liqbot_order_placed_total
- liqbot_order_failed_total
- liqbot_fill_total
- liqbot_risk_daily_cap_hits_total
- liqbot_ws_reconnects_total

Gauges:
- liqbot_feed_price_age_seconds
- liqbot_feed_heatmap_age_seconds
- liqbot_positions_open
- liqbot_risk_used_pct
- liqbot_equity_usd
- liqbot_pnl_realized_usd

Histograms (ms):
- liqbot_decision_latency_ms
- liqbot_order_place_latency_ms

This module is optional and will not crash if `prometheus_client` is absent.
"""
import os
import logging
from typing import Dict, Any, Optional

logger = logging.getLogger(__name__)

try:
    from prometheus_client import (
        Counter, Gauge, Histogram, start_http_server, 
        CollectorRegistry, REGISTRY, generate_latest
    )
    PROM_AVAILABLE = True
except ImportError:
    PROM_AVAILABLE = False
    logger.info("prometheus_client not installed - Prometheus metrics disabled")


# Metric name prefix
PREFIX = "liqbot_"

# Histogram buckets for latency metrics (in ms)
LATENCY_BUCKETS = (1, 5, 10, 25, 50, 100, 250, 500, 1000, 2500, 5000, 10000)


class PrometheusExporter:
    """Prometheus metrics exporter for the liquidation bot.
    
    Usage:
        exporter = PrometheusExporter(port=8000)
        exporter.incr('decision_total')
        exporter.incr('decision_no_trade_total', labels={'reason': 'stale_feed'})
        exporter.gauge('feed_price_age_seconds', 0.5)
        exporter.observe('decision_latency_ms', 42.5)
    """
    
    def __init__(self, port: Optional[int] = None, registry=None, start_server: bool = True):
        self.enabled = PROM_AVAILABLE
        self.port = port or int(os.getenv('PROMETHEUS_PORT', '8000'))
        self.registry = registry or REGISTRY
        self.metrics: Dict[str, Any] = {}
        self._server_started = False
        
        if self.enabled:
            try:
                self._create_metrics()
                if start_server:
                    self._start_server()
            except Exception as e:
                logger.exception("Failed to initialize Prometheus exporter: %s", e)
                self.enabled = False
    
    def _start_server(self):
        """Start the HTTP server for metrics scraping."""
        if self._server_started:
            return
        try:
            start_http_server(self.port, registry=self.registry)
            self._server_started = True
            logger.info(f"Prometheus exporter started on :{self.port}/metrics")
        except OSError as e:
            if "Address already in use" in str(e):
                logger.warning(f"Prometheus port {self.port} already in use - metrics endpoint may be shared")
                self._server_started = True
            else:
                raise
    
    def _create_metrics(self):
        """Create all metrics according to spec."""
        # =====================================================================
        # GAUGES
        # =====================================================================
        self.metrics['feed_price_age_seconds'] = Gauge(
            f'{PREFIX}feed_price_age_seconds',
            'Age of the latest price feed in seconds',
            registry=self.registry
        )
        
        self.metrics['feed_heatmap_age_seconds'] = Gauge(
            f'{PREFIX}feed_heatmap_age_seconds', 
            'Age of the latest heatmap/liquidation data in seconds',
            registry=self.registry
        )
        
        self.metrics['positions_open'] = Gauge(
            f'{PREFIX}positions_open',
            'Number of currently open positions',
            registry=self.registry
        )
        
        self.metrics['risk_used_pct'] = Gauge(
            f'{PREFIX}risk_used_pct',
            'Percentage of daily risk budget used',
            registry=self.registry
        )
        
        self.metrics['equity_usd'] = Gauge(
            f'{PREFIX}equity_usd',
            'Current account equity in USD',
            registry=self.registry
        )
        
        self.metrics['pnl_realized_usd'] = Gauge(
            f'{PREFIX}pnl_realized_usd',
            'Realized PnL in USD for current session',
            registry=self.registry
        )
        
        # =====================================================================
        # COUNTERS
        # =====================================================================
        self.metrics['decision_total'] = Counter(
            f'{PREFIX}decision_total',
            'Total number of signal decisions made',
            registry=self.registry
        )
        
        self.metrics['decision_no_trade_total'] = Counter(
            f'{PREFIX}decision_no_trade_total',
            'Total number of NO_TRADE decisions',
            ['reason'],  # Label for reason
            registry=self.registry
        )
        
        self.metrics['guard_stale_total'] = Counter(
            f'{PREFIX}guard_stale_total',
            'Total number of stale data guard triggers',
            registry=self.registry
        )
        
        self.metrics['guard_edge_total'] = Counter(
            f'{PREFIX}guard_edge_total',
            'Total number of insufficient edge guard triggers',
            registry=self.registry
        )
        
        self.metrics['veto_context_total'] = Counter(
            f'{PREFIX}veto_context_total',
            'Total number of context vetoes',
            ['reason'],  # Label for reason (funding_extreme, oi_misaligned, etc.)
            registry=self.registry
        )
        
        self.metrics['order_placed_total'] = Counter(
            f'{PREFIX}order_placed_total',
            'Total number of orders placed',
            registry=self.registry
        )
        
        self.metrics['order_failed_total'] = Counter(
            f'{PREFIX}order_failed_total',
            'Total number of order placement failures',
            registry=self.registry
        )
        
        self.metrics['fill_total'] = Counter(
            f'{PREFIX}fill_total',
            'Total number of fills received',
            registry=self.registry
        )
        
        self.metrics['risk_daily_cap_hits_total'] = Counter(
            f'{PREFIX}risk_daily_cap_hits_total',
            'Total number of times daily risk cap was hit',
            registry=self.registry
        )
        
        self.metrics['ws_reconnects_total'] = Counter(
            f'{PREFIX}ws_reconnects_total',
            'Total number of WebSocket reconnections',
            registry=self.registry
        )
        
        # =====================================================================
        # HISTOGRAMS
        # =====================================================================
        self.metrics['decision_latency_ms'] = Histogram(
            f'{PREFIX}decision_latency_ms',
            'Decision processing latency in milliseconds',
            buckets=LATENCY_BUCKETS,
            registry=self.registry
        )
        
        self.metrics['order_place_latency_ms'] = Histogram(
            f'{PREFIX}order_place_latency_ms',
            'Order placement latency in milliseconds',
            buckets=LATENCY_BUCKETS,
            registry=self.registry
        )
    
    def incr(self, name: str, amount: float = 1, labels: Optional[Dict[str, str]] = None):
        """Increment a counter metric.
        
        Args:
            name: Metric name (without liqbot_ prefix)
            amount: Amount to increment by
            labels: Optional labels dict
        """
        if not self.enabled:
            return
        try:
            metric = self.metrics.get(name)
            if metric is None:
                logger.warning(f"Unknown metric: {name}")
                return
            
            if labels:
                metric.labels(**labels).inc(amount)
            else:
                metric.inc(amount)
        except Exception:
            logger.exception(f'Failed to increment metric {name}')
    
    def gauge(self, name: str, value: float, labels: Optional[Dict[str, str]] = None):
        """Set a gauge metric value.
        
        Args:
            name: Metric name (without liqbot_ prefix)
            value: Value to set
            labels: Optional labels dict
        """
        if not self.enabled:
            return
        try:
            metric = self.metrics.get(name)
            if metric is None:
                logger.warning(f"Unknown metric: {name}")
                return
            
            if labels:
                metric.labels(**labels).set(value)
            else:
                metric.set(value)
        except Exception:
            logger.exception(f'Failed to set gauge {name}')
    
    def observe(self, name: str, value: float, labels: Optional[Dict[str, str]] = None):
        """Observe a histogram value.
        
        Args:
            name: Metric name (without liqbot_ prefix)
            value: Value to observe
            labels: Optional labels dict
        """
        if not self.enabled:
            return
        try:
            metric = self.metrics.get(name)
            if metric is None:
                logger.warning(f"Unknown metric: {name}")
                return
            
            if labels:
                metric.labels(**labels).observe(value)
            else:
                metric.observe(value)
        except Exception:
            logger.exception(f'Failed to observe histogram {name}')
    
    def get_metrics(self) -> bytes:
        """Get all metrics in Prometheus text format."""
        if not self.enabled:
            return b''
        try:
            return generate_latest(self.registry)
        except Exception:
            logger.exception("Failed to generate metrics")
            return b''


# Global singleton
_exporter: Optional[PrometheusExporter] = None


def get_prometheus_exporter(port: Optional[int] = None) -> PrometheusExporter:
    """Get or create the global Prometheus exporter singleton."""
    global _exporter
    if _exporter is None:
        _exporter = PrometheusExporter(port=port)
    return _exporter

