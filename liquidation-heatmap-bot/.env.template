# Trading Bot Environment Configuration Template
# Copy this to .env and fill in your values

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
ENV=prod  # Options: dev, prod
TRADING_MODE=PAPER  # Options: PAPER, LIVE

# ==============================================================================
# POSTGRESQL (Optional - for durable event storage)
# ==============================================================================
ENABLE_POSTGRES=0  # Set to 1 to enable PostgreSQL emitter
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=trading_bot
POSTGRES_USER=trading_bot_user
POSTGRES_PASSWORD=your_secure_password_here

# ==============================================================================
# SLACK (Optional - for critical alerts)
# ==============================================================================
SLACK_WEBHOOK_URL=  # https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ==============================================================================
# BINANCE API (Required for live trading)
# ==============================================================================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ==============================================================================
# GOOGLE SHEETS (Required for data sources)
# ==============================================================================
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
LIQUIDATION_SPREADSHEET_KEY=your_liquidation_sheet_key
OI_FR_SPREADSHEET_KEY=your_oi_fr_sheet_key
OUTPUT_SPREADSHEET_KEY=your_output_sheet_key

# ==============================================================================
# RISK MANAGEMENT
# ==============================================================================
DAILY_RISK_CAP_PCT=0.02  # 2% of equity per day
MAX_POSITION_SIZE_PCT=0.10  # 10% of equity per position
MIN_EDGE_BPS=20  # Minimum edge in basis points to trade
EDGE_CALIBRATION_ENABLED=1  # Enable edge calibration

# ==============================================================================
# OBSERVABILITY
# ==============================================================================
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR
PROMETHEUS_PORT=8000
ENABLE_CSV_LOGS=1
ENABLE_LLM_SUMMARIES=1
LLM_SUMMARY_CHUNK_SIZE=500  # Lines per chunk (dev), 5000 for prod

# ==============================================================================
# PERFORMANCE
# ==============================================================================
SKIP_STARTUP_DELAY=0  # Set to 1 to skip startup delays (for testing)
HEARTBEAT_INTERVAL_S=60  # Health check interval in seconds
