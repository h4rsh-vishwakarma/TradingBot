                        'threshold_funding_s': self.trading_config.funding_stale_seconds,
                        'threshold_lsr_s': self.trading_config.lsr_stale_seconds
                    }
                )
                # Note: This blocks NEW entries but should allow exits/risk management
                # For now, returning to block all signal generation
                return
            
            logger.info(f"✅ Staleness checks PASSED: price={price_age:.1f}s, heatmap={cluster_age:.1f}s, "
                       f"oi={oi_age:.1f}s, funding={funding_age:.1f}s, lsr={lsr_age:.1f}s")
            
            # Check if we're in cooldown (prevent duplicate signals)
            if (self.last_signal_time and 
                (now - self.last_signal_time).total_seconds() < self.trading_config.signal_cooldown_minutes * 60):
                cooldown_remaining = self.trading_config.signal_cooldown_minutes * 60 - (now - self.last_signal_time).total_seconds()
                logger.debug(f"Signal cooldown active: {cooldown_remaining:.0f}s remaining")
                # Log NO_TRADE decision during cooldown for observability
                self._log_decision_event(
                    direction=None, 
                    action='NO_TRADE', 
                    bias_reason=f'Signal cooldown active ({cooldown_remaining:.0f}s remaining)',
                    confidence=0.0, 
                    oi_signal=('NEUTRAL', 'Cooldown'),
                    funding_signal=('NEUTRAL', 'Cooldown'),
                    clusters_count=0, 
                    multi_tf=0.0, 
                    signal=None,
                    votes=None
                )
                return
            
            # Existing informational log kept for continuity
            logger.debug("Internal: proceeding with enhanced RL signal workflow")
            
            # Extract BTC-focused features
            market_features = self._extract_btc_features()
            if not market_features:
                logger.warning("Failed to extract market features")
                return
            
            # Analyze market regime
            regime_metrics = self.market_regime_detector.detect_regime(self.ltf_data)
            
            # Multi-timeframe analysis
            # Use aggregated data if available, otherwise fallback to just 5m
            multi_tf_input = self.multi_tf_data if hasattr(self, 'multi_tf_data') else {'5m': self.ltf_data}
            # Ensure 5m is present (aggregator might not include it if empty, though it should)
            if '5m' not in multi_tf_input:
                multi_tf_input['5m'] = self.ltf_data
            
            # Debug: Log multi_tf_input data availability
            logger.info(f"Multi-TF Input: {', '.join([f'{tf}={len(df)} bars' for tf, df in multi_tf_input.items() if not df.empty])}")
                
            multi_tf_signals = self.multi_tf_analyzer.analyze_multi_timeframe(multi_tf_input)
            
            # Analyze OI and funding (already done above for prediction logging, but re-do for consistency)
            # Check OI data staleness before analysis
            oi_age_s = 999
            if isinstance(self.oi_data, pd.DataFrame) and not self.oi_data.empty and 'Timestamp (UTC)' in self.oi_data.columns:
                try:
                    oi_timestamp = pd.to_datetime(self.oi_data['Timestamp (UTC)'].iloc[-1])
                    # Ensure timezone-aware comparison using tz_localize for naive timestamps
                    if oi_timestamp.tzinfo is None:
                        oi_timestamp = oi_timestamp.tz_localize('UTC')
                    oi_age_s = (datetime.now(timezone.utc) - oi_timestamp).total_seconds()
                    if oi_age_s > 600:  # 10 minutes
                        logger.warning(f"Stale OI data: {oi_age_s:.0f}s old")
                except Exception as e:
                    logger.error(f"Failed to compute OI age: {e}")
            
            # Gate OI analysis on staleness
            if oi_age_s > 600:
                oi_signal = ("NEUTRAL", f"Stale OI data ({oi_age_s:.0f}s)")
            else:
                oi_signal = self.analyze_oi_trend(self.oi_data, self.current_price)
            
            # Check Funding data staleness before analysis
            fr_age_s = 999
            if isinstance(self.funding_data, pd.DataFrame) and not self.funding_data.empty and 'Timestamp' in self.funding_data.columns:
                try:
                    fr_timestamp = pd.to_datetime(self.funding_data['Timestamp'].iloc[-1])
                    # Ensure timezone-aware comparison using tz_localize for naive timestamps
                    if fr_timestamp.tzinfo is None:
                        fr_timestamp = fr_timestamp.tz_localize('UTC')
                    fr_age_s = (datetime.now(timezone.utc) - fr_timestamp).total_seconds()
                    if fr_age_s > 300:  # 5 minutes
                        logger.warning(f"Stale funding data: {fr_age_s:.0f}s old")
                except Exception as e:
                    logger.error(f"Failed to compute funding age: {e}")
            
            # Gate Funding analysis on staleness
            if fr_age_s > 300:
                funding_signal = ("NEUTRAL", f"Stale funding data ({fr_age_s:.0f}s)")
            else:
                funding_signal = self.analyze_funding_rate(self.funding_data)
            
            lsr_signal = self.analyze_lsr_trend(self.lsr_data)
            
            # Find strong liquidation clusters
            strong_clusters = self._find_strong_clusters()
            if len(strong_clusters) == 0 and not force_disable_guards:
                logger.info("No strong liquidation clusters found")
                # Allow debug forced signal even without clusters if env set
                if os.getenv("FORCE_DEBUG_SIGNAL", "0") == "1" and not self.debug_forced_once:
                    self._force_debug_signal()
                return
            elif len(strong_clusters) == 0 and force_disable_guards:
                logger.info("Guards disabled: proceeding without strong clusters")
            
            # Find nearest clusters
            nearest_above, nearest_below = self.find_nearest_clusters(self.current_price, strong_clusters)
            
            # Calculate trading bias
            bias, bias_reason, votes, tie_break_used = self.calculate_bias(
                nearest_above, nearest_below, self.current_price, self.current_vwap, oi_signal, funding_signal, lsr_signal
            )
            
            # Log market analysis
            self._log_market_analysis(regime_metrics, multi_tf_signals, oi_signal, funding_signal, bias, bias_reason)
            logger.info(f"LSR Signal: {lsr_signal[0]} ({lsr_signal[1]:.4f})")
            
            # ===== TIER 2: HARD MTF REGIME FILTERS (P2 ENHANCED) =====
            # Block entries that fight strong higher-timeframe trends
            # P2: Stricter thresholds and volatility checks
            if bias and multi_tf_signals and self.trading_config.bias_filter_enabled:
                try:
                    mtf_data = multi_tf_signals
                    trend_1h = mtf_data.get('1h_trend', 0)
                    trend_4h = mtf_data.get('4h_trend', 0)
                    
                    # Calculate higher-TF trend strength
                    htf_trend = (trend_1h + trend_4h) / 2.0
                    
                    # Get cluster quality if nearest cluster available
                    target_cluster = nearest_below if bias == 'LONG' else nearest_above
                    cluster_quality = 0.5
                    if target_cluster is not None:
                        cluster_quality = float(target_cluster.get('cluster_quality', 0.5))
                    
                    # Get regime confidence and volatility
                    regime_confidence = regime_metrics.confidence if regime_metrics else 0.5
                    volatility_regime = regime_metrics.volatility if regime_metrics else 'NORMAL'
                    
                    # P2: Block trades in extreme volatility regardless of direction
                    if volatility_regime == 'EXTREME':
                        logger.error(f"⛔ HARD VETO: MTF_REGIME_EXTREME_VOLATILITY - "
                                   f"volatility={volatility_regime}, regime_conf={regime_confidence:.2f}")
                        self.emitters.emit_veto(
                            reason="MTF_REGIME_EXTREME_VOLATILITY",
                            fields={
                                'details': "Cannot trade in extreme volatility regime",
                                'bias': bias,
                                'volatility_regime': volatility_regime,
                                'regime_confidence': regime_confidence
                            }
                        )
                        return  # Block trade
                    
                    # P2: STRICTER VETO - Block LONG when moderate-to-strong downtrend (threshold lowered from -0.4 to -0.3)
                    if bias == 'LONG' and htf_trend < -0.3:  # Moderate downtrend
                        # More permissive only if cluster quality is excellent (>0.7) AND high regime confidence (>0.7)
                        if not (cluster_quality > 0.7 and regime_confidence > 0.7):
                            logger.error(f"⛔ HARD VETO: MTF_REGIME_LONG_VS_DOWNTREND - "
                                       f"HTF trend={htf_trend:.2f}, cluster_q={cluster_quality:.2f}, regime_conf={regime_confidence:.2f}, vol={volatility_regime}")
                            self.emitters.emit_veto(
                                reason="MTF_REGIME_LONG_VS_DOWNTREND",
                                fields={
                                    'details': f"Cannot LONG against HTF downtrend without excellent setup (need cluster_q>0.7 AND regime_conf>0.7)",
                                    'bias': bias,
                                    'htf_trend': htf_trend,
                                    'trend_1h': trend_1h,
                                    'trend_4h': trend_4h,
                                    'cluster_quality': cluster_quality,
                                    'regime_confidence': regime_confidence,
                                    'volatility_regime': volatility_regime
                                }
                            )
                            return  # Block trade
                    
                    # P2: STRICTER VETO - Block SHORT when moderate-to-strong uptrend (threshold lowered from 0.4 to 0.3)
                    elif bias == 'SHORT' and htf_trend > 0.3:  # Moderate uptrend
                        # More permissive only if cluster quality is excellent (>0.7) AND high regime confidence (>0.7)
                        if not (cluster_quality > 0.7 and regime_confidence > 0.7):
                            logger.error(f"⛔ HARD VETO: MTF_REGIME_SHORT_VS_UPTREND - "
                                       f"HTF trend={htf_trend:.2f}, cluster_q={cluster_quality:.2f}, regime_conf={regime_confidence:.2f}, vol={volatility_regime}")
                            self.emitters.emit_veto(
                                reason="MTF_REGIME_SHORT_VS_UPTREND",
                                fields={
                                    'details': f"Cannot SHORT against HTF uptrend without excellent setup (need cluster_q>0.7 AND regime_conf>0.7)",
                                    'bias': bias,
                                    'htf_trend': htf_trend,
                                    'trend_1h': trend_1h,
                                    'trend_4h': trend_4h,
                                    'cluster_quality': cluster_quality,
                                    'regime_confidence': regime_confidence,
                                    'volatility_regime': volatility_regime
                                }
                            )
                            return  # Block trade
                    
                    logger.info(f"✅ MTF regime filter passed: bias={bias}, htf_trend={htf_trend:.2f}, cluster_q={cluster_quality:.2f}, vol={volatility_regime}")
                except Exception as e:
                    logger.error(f"MTF regime filter error: {e}", exc_info=True)
            
            if bias is None:
                # Attempt relaxed fallbacks before giving up
                logger.info("No clear trading bias detected - attempting relaxed fallbacks")
                relax_reason = None

                # 1) VWAP fallback REMOVED (P0 Improvement)
                # Strict veto logic prevents reaching here with stale heatmap

                # 2) Cluster-based override if many strong clusters exist
                cluster_override_count = 3  # Define minimum cluster count for override
                if bias is None and len(strong_clusters) >= cluster_override_count:
                    try:
                        long_density = float(strong_clusters[strong_clusters['cluster_type'].str.contains('LONG', na=False)]['density'].sum())
                        short_density = float(strong_clusters[strong_clusters['cluster_type'].str.contains('SHORT', na=False)]['density'].sum())
                        logger.info("Cluster override check: long_density=%.3f short_density=%.3f count=%d", long_density, short_density, len(strong_clusters))
                        if long_density > short_density * 1.15:
                            bias = 'LONG'
                            relax_reason = 'CLUSTER_OVERRIDE_LONG'
                            bias_reason = f"Cluster override: long_density {long_density:.3f} vs short {short_density:.3f}"
                        elif short_density > long_density * 1.15:
                            bias = 'SHORT'
                            relax_reason = 'CLUSTER_OVERRIDE_SHORT'
                            bias_reason = f"Cluster override: short_density {short_density:.3f} vs long {long_density:.3f}"
                        if bias:
                            logger.info("Cluster override selected bias=%s reason=%s", bias, bias_reason)
                    except Exception:
                        logger.exception("Error during cluster override logic")

                if bias is None:
                    logger.info("No bias after fallbacks (will not generate signal this cycle)")
                    if os.getenv("FORCE_DEBUG_SIGNAL", "0") == "1" and not self.debug_forced_once:
                        self._force_debug_signal(oi_signal, funding_signal, regime_metrics, multi_tf_signals, strong_clusters)
                    return

            # Context veto checks
            veto_reason = None
            if bias == 'LONG' and funding_signal[0] == 'BEARISH':
                veto_reason = 'funding_extreme_against_long'
            if bias == 'SHORT' and funding_signal[0] == 'BULLISH':
                veto_reason = 'funding_extreme_against_short'
            if veto_reason:
                self._log_veto_event(veto_reason, {'funding': funding_signal[1], 'bias': bias})
                if metrics.PROM_AVAILABLE:
                    try: metrics.veto_context_counter.labels(reason=veto_reason).inc()
                    except Exception: pass
                return
            
            # Generate enhanced signal with RL validation
            signal = self._generate_validated_signal(
                bias, nearest_above, nearest_below, oi_signal, funding_signal, 
                regime_metrics, multi_tf_signals, market_features, bias_reason
            )
            
            if signal and signal.get('confidence', 0) >= self.trading_config.min_confidence_threshold:
                self.execute_enhanced_signal(signal)
                self.last_signal_time = now  # Set cooldown after successful signal
                self._log_decision_event(direction=signal['direction'], action='PLACE', bias_reason=bias_reason,
                                         confidence=signal.get('confidence',0), oi_signal=oi_signal, funding_signal=funding_signal,
                                         clusters_count=len(strong_clusters), multi_tf=multi_tf_signals['overall_score'], signal=signal, votes=votes)
            else:
                if signal:
                    logger.info(
                        f"Signal rejected: confidence {signal.get('confidence',0):.2f} < threshold {self.trading_config.min_confidence_threshold:.2f} | rr={signal.get('rr_ratio')} cluster_strength={signal.get('cluster_strength')} multi_tf={signal.get('multi_tf_score'):.2f}" )
                    self._log_decision_event(direction=signal.get('direction'), action='NO_TRADE', bias_reason=bias_reason,
                                             confidence=signal.get('confidence',0), oi_signal=oi_signal, funding_signal=funding_signal,
                                             clusters_count=len(strong_clusters), multi_tf=multi_tf_signals['overall_score'], signal=signal, votes=votes)
                else:
                    logger.info("Signal generation returned None (entry conditions not met)")
                    self._log_decision_event(direction=None, action='NO_TRADE', bias_reason='Entry conditions failed',
                                             confidence=0.0, oi_signal=oi_signal, funding_signal=funding_signal,
                                             clusters_count=len(strong_clusters), multi_tf=multi_tf_signals['overall_score'], signal=None, votes=votes)
            # Decision latency metric
            if metrics.PROM_AVAILABLE:
                try:
                    elapsed = (time.time()*1000.0) - start_ms
                    metrics.decision_latency_hist.observe(max(0.0, elapsed))
                except Exception:
                    pass
                
        except Exception as e:
            import traceback
            logger.error(f"Error in signal generation: {e}")
            logger.error(f"Traceback: {traceback.format_exc()}")
            self._log_error_event('signal_generation','ERROR',f"{e}\n{traceback.format_exc()}")
            return

    def _validate_data_availability(self) -> bool:
        """Validate that all required data is available"""
        if self.current_price is None:
            logger.info("📊 DATA CHECK FAIL: No current price available")
            return False
        
        if self.clusters_df is None or self.clusters_df.empty:
            logger.info("📊 DATA CHECK FAIL: No liquidation clusters available")
            return False
        
        if self.ltf_data is None or len(self.ltf_data) < 5:
            candle_count = len(self.ltf_data) if self.ltf_data is not None else 0
            logger.info(f"📊 DATA CHECK FAIL: Insufficient price data: {candle_count} candles (need 5)")
            return False
        
        logger.info(f"📊 DATA CHECK PASS: Price=${self.current_price:.2f}, Clusters={len(self.clusters_df)}, Candles={len(self.ltf_data)}")
        return True
    
    def _extract_btc_features(self) -> Optional[Dict]:
        """Extract BTC-focused market features"""
        try:
            # Prepare market data for feature extraction
            market_data = {
                'btc_prices': pd.Series(self.ltf_data['close']),
                'volumes': pd.Series(self.ltf_data['volume']),
                'high': pd.Series(self.ltf_data['high']),
                'low': pd.Series(self.ltf_data['low']),
                'open': pd.Series(self.ltf_data['open'])
            }
            
            liquidation_data = {
                'clusters': self.clusters_df,
                'price': self.current_price  # Add current price to liquidation data
            }
            
            # Extract features using the feature engine
            features = self.feature_engine.extract_all_features(market_data, liquidation_data, self.current_price)
            
            if features:
                logger.info(f"Extracted {len(features.normalize_features())} BTC-focused features")
                return features.normalize_features()
            
            return None
            
        except Exception as e:
            logger.error(f"Error extracting BTC features: {e}")
            return None
    
    def _find_strong_clusters(self) -> pd.DataFrame:
        """Find strong liquidation clusters based on density threshold"""
        try:
            strong_clusters = self.clusters_df[
                self.clusters_df['density'] >= self.trading_config.cluster_density_threshold
            ].copy()
            
            # Additional filtering for cluster quality
            if len(strong_clusters) > 0:
                # Filter by minimum cluster points (use data_points column)
                strong_clusters = strong_clusters[
                    strong_clusters['data_points'] >= self.trading_config.min_cluster_points
                ]
                
                # Sort by density (strongest first)
                strong_clusters = strong_clusters.sort_values('density', ascending=False)
            
            logger.info(f"Found {len(strong_clusters)} strong liquidation clusters")
            return strong_clusters
            
        except Exception as e:
            logger.error(f"Error finding strong clusters: {e}")
            return pd.DataFrame()

    def _generate_validated_signal(self, bias, nearest_above, nearest_below, oi_signal, funding_signal, regime_metrics, multi_tf_signals, market_features, bias_reason):
        """
        Generate a validated signal with comprehensive risk gating.
        
        Validation layers (P0 = hard stop, P1 = strong filter):
        1. Risk invariants (P0): Daily cap, max positions, R-sizing
        2. Edge calibration (P0): Calibrated edge > costs + no-trade band
        3. Cluster metrics (P1): Avoid entries near opposite clusters
        4. Regime filters (P1): Avoid counter-trend, extreme volatility
        5. Execution quality (P2): Spread-aware limit pricing
        """
        logger.debug(f"_generate_validated_signal called: bias={bias}, nearest_above={nearest_above is not None}, nearest_below={nearest_below is not None}")
        if not bias:
            logger.info("Signal validation: No bias provided, returning None")
            return None

        try:
            # === LAYER 0: Determine Limit Price with Spread Awareness ===
            limit_price = self.current_price
            order_type = 'LIMIT'
            spread_bps = None
            
            # Get bid/ask
            bid = getattr(self.binance_ws, 'best_bid', None)
            ask = getattr(self.binance_ws, 'best_ask', None)
            
            # Use execution monitor for spread-aware pricing
            if self.execution_monitor and bid and ask:
                pricing = self.execution_monitor.get_spread_aware_limit_price(
                    current_price=self.current_price,
                    side=bias,
                    bid=bid,
                    ask=ask,
                    urgency='normal'  # Can be adjusted based on signal strength
                )
                limit_price = pricing['limit_price']
                spread_bps = pricing.get('spread_bps')
                
                # P2: VETO on wide spreads to avoid excessive slippage costs
                MAX_SPREAD_BPS = 15.0  # Beyond maker fee (~2) + taker fee (~5) + typical slippage (~5) + margin
                if spread_bps and spread_bps > MAX_SPREAD_BPS:
                    logger.error(f"⛔ HARD VETO: WIDE_SPREAD - spread={spread_bps:.1f} BPS > {MAX_SPREAD_BPS} BPS threshold")
                    self.emitters.emit_veto(
                        reason="WIDE_SPREAD",
                        fields={
                            'details': f"Spread too wide ({spread_bps:.1f} BPS), likely to incur excessive slippage",
                            'bias': bias,
                            'spread_bps': spread_bps,
                            'max_spread_bps': MAX_SPREAD_BPS,
                            'bid': bid,
                            'ask': ask,
                            'current_price': self.current_price
                        }
                    )
                    return  # Block trade
                
                if pricing.get('spread_warning'):
                    logger.info(f"⚠️ {pricing['spread_warning']}")
            else:
                # Fallback to original logic
                if bias == 'LONG':
                    if hasattr(self.binance_ws, 'best_bid') and self.binance_ws.best_bid:
                        limit_price = self.binance_ws.best_bid
                    else:
                        limit_price = self.current_price
                elif bias == 'SHORT':
                    if hasattr(self.binance_ws, 'best_ask') and self.binance_ws.best_ask:
                        limit_price = self.binance_ws.best_ask
                    else:
                        limit_price = self.current_price
            
            # === RAW SIGNAL INTENT (NO STOP/TP/SIZE CALCULATION) ===
            # Signal generator identifies entry opportunity + cluster suggestions
            # Stop-loss calculation happens LATER in execute_enhanced_signal
            
            cluster_stop_suggestion = None
            opposing_cluster_suggestion = None
            
            if bias == 'LONG':
                if nearest_below is not None:
                    cluster_stop_suggestion = nearest_below['mean_price']  # Suggestion only, NOT final stop
                if nearest_above is not None:
                    opposing_cluster_suggestion = nearest_above['mean_price']

            elif bias == 'SHORT':
                if nearest_above is not None:
                    cluster_stop_suggestion = nearest_above['mean_price']  # Suggestion only, NOT final stop
                if nearest_below is not None:
                    opposing_cluster_suggestion = nearest_below['mean_price']
            
            # Get ATR for stop_loss_manager (volatility context)
            atr = market_features.get('atr', limit_price * 0.01) if market_features else limit_price * 0.01
            
            # Format cluster values for logging
            cluster_stop_str = f"${cluster_stop_suggestion:.2f}" if cluster_stop_suggestion else "$0.00"
            opposing_str = f"${opposing_cluster_suggestion:.2f}" if opposing_cluster_suggestion else "$0.00"
            
            logger.info(
                f"📤 RAW SIGNAL INTENT: bias={bias}, entry=${limit_price:.2f}, "
                f"cluster_stop_suggestion={cluster_stop_str}, opposing={opposing_str}, atr=${atr:.2f}"
            )
            
            # === LAYER 2: Compute Edge BPS (Signal Quality Metric) ===
            raw_multi_tf_score = multi_tf_signals.get('overall_score', 0.0) if multi_tf_signals else 0.0
            multi_tf_score = abs(raw_multi_tf_score)
            target_cluster = nearest_above if bias == 'SHORT' else nearest_below
            
            # Log target cluster info
            target_cluster_price = target_cluster.get('mean_price', 0) if target_cluster is not None else 0
            logger.info(f"Edge Calc: bias={bias}, target_cluster_price=${target_cluster_price:.2f}, multi_tf={multi_tf_score:.2f}")
            
            edge_bps = self.compute_edge_bps(bias, limit_price, target_cluster, multi_tf_score)
            logger.info(f"Computed edge_bps={edge_bps:.2f} (min required={self.min_edge_bps})")
            
            # === NEW VALIDATORS: P0 + P1 Gating ===
            veto_reasons = []  # Track all rejection reasons
            guard_kinds = []   # Track advisory guards
            
            # NOTE: Risk invariants validation moved to execute_enhanced_signal
            # AFTER stop_loss_manager calculates commission-safe stop/TP

            
            # --- P0 Validator 2: Edge Calibration ---
            if self.edge_calibrator and not veto_reasons:
                try:
                    should_trade, edge_details = self.edge_calibrator.should_trade(edge_bps)
                    if not should_trade:
                        veto_reason = f"EDGE_CALIBRATION_{edge_details['rejection_reason']}"
                        veto_reasons.append(veto_reason)
                        logger.info(f"❌ Edge veto: {edge_details['rejection_reason']} "
                                   f"(cal={edge_details['calibrated_edge_bps']:.1f} BPS, "
                                   f"after_costs={edge_details['edge_after_costs_bps']:.1f} BPS)")
                        
                        # Emit veto event to JSONL/CSV
                        if self.emitters:
                            try:
                                self.emitters.emit_veto(
                                    reason=veto_reason,
                                    fields={
                                        'raw_edge_bps': edge_bps,
                                        'calibrated_edge_bps': edge_details.get('calibrated_edge_bps'),
                                        'edge_after_costs_bps': edge_details.get('edge_after_costs_bps'),
                                        'rejection_reason': edge_details.get('rejection_reason'),
                                        'bias': bias,
                                        'price': limit_price
                                    }
                                )
                            except Exception as emit_err:
                                logger.debug(f"Veto emit error: {emit_err}")
                except Exception as e:
                    logger.error(f"Edge calibration error: {e}")
            
            # --- P1 Validator 3: Cluster Metrics ---
            cluster_metrics_obj = None
            cluster_distance_bps = 0.0  # Default to 0 instead of None
            cluster_width_bps = 0.0
            cluster_intensity_z = 0.0
            cluster_size_usd = 0.0
            cluster_strength = 0
            cluster_density = 0.0
            
            # P0 FIX: Extract cluster metrics directly from nearest cluster
            if hasattr(self, 'clusters_df') and not self.clusters_df.empty and limit_price:
                try:
                    # Find nearest cluster based on bias
