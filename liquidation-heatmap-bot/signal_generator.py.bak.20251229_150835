            'volatility': signal.get('volatility_regime') if signal else None,
            'regime_tag': signal.get('regime_tag') if signal else None,
            'edge_bps': edge_bps,
            'edge_ok': edge_ok,
            'entry_px': signal.get('entry_price') if signal else None,
            'stop_px': signal.get('stop_loss') if signal else None,
            'tp_px': signal.get('take_profit') if signal else None,
            'qty': signal.get('quantity') if signal else None,
            'veto_reasons': signal.get('veto_reasons', []) if signal else [],
            'guard_kinds': signal.get('guard_kinds', []) if signal else [],
            'cluster_distance_bps': signal.get('cluster_distance_bps') if signal else None,
            'cluster_width_bps': signal.get('cluster_width_bps') if signal else None,
            'cluster_intensity_z': signal.get('cluster_intensity_z') if signal else None,
            'cluster_size_usd': signal.get('cluster_size_usd') if signal else None,
        }
        
        if self.emitters:
