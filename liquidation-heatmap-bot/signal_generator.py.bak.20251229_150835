    def _compute_data_quality_score(self) -> Tuple[float, Dict[str, float]]:
        """Compute composite data quality score (0-1)."""
        now = datetime.now(timezone.utc)
        def freshness(age: Optional[float], threshold: float) -> float:
            if age is None:
                return 0.0
            if age <= threshold:
                return 1.0
            extreme = threshold * int(os.getenv("EXTREME_STALE_MULT", "3"))
            if age >= extreme:
                return 0.0
            return max(0.0, 1.0 - (age - threshold) / (extreme - threshold))

        price_age = (now - self.last_price_update_time).total_seconds() if self.last_price_update_time else None
        cluster_age = (now - self.last_cluster_update_time).total_seconds() if self.last_cluster_update_time else None
        data_load_age = (now - self.last_data_load_time).total_seconds() if self.last_data_load_time else None

        price_score = freshness(price_age, int(os.getenv("PRICE_STALE_SECONDS","600")))
        cluster_score = freshness(cluster_age, int(os.getenv("HEATMAP_STALE_SECONDS","900")))
        load_score = freshness(data_load_age, int(os.getenv("DATA_STALE_SECONDS","900")))

        # Availability components
        oi_rows = len(self.oi_data) if isinstance(self.oi_data, pd.DataFrame) else 0
        funding_rows = len(self.funding_data) if isinstance(self.funding_data, pd.DataFrame) else 0
        oi_score = 1.0 if oi_rows >= 2 else (0.5 if oi_rows == 1 else 0.0)
        funding_score = 1.0 if funding_rows >= 2 else (0.5 if funding_rows == 1 else 0.0)

        # Feature completeness proxy: fraction of candles vs expected (assume need 100)
        expected_candles = int(os.getenv("EXPECTED_CANDLES","100"))
        have_candles = len(self.ltf_data) if self.ltf_data is not None else 0
        completeness = max(0.0, min(1.0, have_candles / expected_candles))

        components = {
            'price_freshness': price_score,
            'cluster_freshness': cluster_score,
            'data_load_freshness': load_score,
            'oi_availability': oi_score,
            'funding_availability': funding_score,
            'feature_completeness': completeness
        }
        aggregate = (
            price_score * 0.3 +
            cluster_score * 0.2 +
            load_score * 0.15 +
            oi_score * 0.15 +
            funding_score * 0.1 +
            completeness * 0.1
        )
        self.last_quality_score = aggregate
        self.last_quality_components = components
        # Structured event
        try:
            logger.info(json.dumps({'event':'quality.score','timestamp':now.isoformat()+"Z",'score':aggregate,'components':components}))
            if metrics.PROM_AVAILABLE:
                metrics.data_quality_score_gauge.set(aggregate)
        except Exception:
            pass
        return aggregate, components

