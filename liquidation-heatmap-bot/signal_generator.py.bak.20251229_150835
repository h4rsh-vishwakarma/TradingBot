    def _detect_liquidation_type(self, df):
        """Auto-detect liquidation type (long/short) based on market conditions"""
        liquidation_types = []
        
        for idx, row in df.iterrows():
            liquidation_price = row['price']
            liquidation_time = row['time']
            
            # Get market context at liquidation time
            market_context = self._get_market_context_at_time(liquidation_time, liquidation_price)
            
            # Determine liquidation type based on context
            liquidation_type = self._classify_liquidation_type(market_context, liquidation_price)
            liquidation_types.append(liquidation_type)
        
        return liquidation_types
    
    def _get_market_context_at_time(self, liquidation_time, liquidation_price):
        """Get market context at the time of liquidation"""
        context = {
            'price': liquidation_price,
            'time': liquidation_time,
            'trend': 'neutral',
            'volatility': 'normal',
            'volume': 'normal',
            'momentum': 'neutral'
        }
        
        # Use current market data as proxy (in production, you'd use historical data)
        if self.ltf_data is not None and len(self.ltf_data) > 20:
            # Calculate trend
            close_prices = self.ltf_data['close']
            sma_20 = close_prices.rolling(window=20).mean().iloc[-1]
            sma_5 = close_prices.rolling(window=5).mean().iloc[-1]
            
            if sma_5 > sma_20 * 1.002:
                context['trend'] = 'bullish'
            elif sma_5 < sma_20 * 0.998:
                context['trend'] = 'bearish'
            
            # Calculate volatility
            returns = close_prices.pct_change().dropna()
            volatility = returns.rolling(window=20).std().iloc[-1]
            
            if volatility > 0.02:
                context['volatility'] = 'high'
            elif volatility < 0.01:
                context['volatility'] = 'low'
            
            # Calculate momentum
            price_change_5 = (close_prices.iloc[-1] - close_prices.iloc[-5]) / close_prices.iloc[-5]
            
            if price_change_5 > 0.01:
                context['momentum'] = 'bullish'
            elif price_change_5 < -0.01:
                context['momentum'] = 'bearish'
            
            # Calculate volume
            volumes = self.ltf_data['volume']
            avg_volume = volumes.rolling(window=20).mean().iloc[-1]
            current_volume = volumes.iloc[-1]
            volume_ratio = current_volume / avg_volume if avg_volume > 0 else 1
            
            if volume_ratio > 1.5:
                context['volume'] = 'high'
            elif volume_ratio < 0.7:
                context['volume'] = 'low'
        
        return context
    
    def _classify_liquidation_type(self, market_context, liquidation_price):
        """Classify liquidation as long or short based on market context"""
        trend = market_context['trend']
        momentum = market_context['momentum']
        volatility = market_context['volatility']
        volume = market_context['volume']
        
        # Get current price for comparison
        current_price = self.current_price or liquidation_price
        
        # Price position analysis
        price_position = liquidation_price / current_price if current_price > 0 else 1
        
        # Liquidation classification logic
        liquidation_score: Dict[str, float] = {'long': 0.0, 'short': 0.0}
        
        # Trend-based classification
        if trend == 'bullish':
            # In bullish trend, liquidations above current price are likely short liquidations
            if price_position > 1.005:  # 0.5% above current price
                liquidation_score['short'] += 2
            elif price_position < 0.995:  # 0.5% below current price
                liquidation_score['long'] += 2
        elif trend == 'bearish':
            # In bearish trend, liquidations below current price are likely long liquidations
            if price_position < 0.995:  # 0.5% below current price
                liquidation_score['long'] += 2
            elif price_position > 1.005:  # 0.5% above current price
                liquidation_score['short'] += 2
        
        # Momentum-based classification
        if momentum == 'bullish':
            if price_position > 1.003:  # Above current price in bullish momentum
                liquidation_score['short'] += 1
            elif price_position < 0.997:  # Below current price in bullish momentum
                liquidation_score['long'] += 1
        elif momentum == 'bearish':
            if price_position < 0.997:  # Below current price in bearish momentum
                liquidation_score['long'] += 1
            elif price_position > 1.003:  # Above current price in bearish momentum
                liquidation_score['short'] += 1
        
        # Volatility-based classification
        if volatility == 'high':
            # High volatility increases uncertainty
            liquidation_score['long'] += 0.5
            liquidation_score['short'] += 0.5
        
        # Volume-based classification
        if volume == 'high':
            # High volume suggests strong directional move
            if trend == 'bullish':
                liquidation_score['short'] += 1
            elif trend == 'bearish':
                liquidation_score['long'] += 1
        
        # Determine final classification
        if liquidation_score['long'] > liquidation_score['short']:
            return 'long'
        elif liquidation_score['short'] > liquidation_score['long']:
            return 'short'
        else:
            return 'mixed'
    
    def _parse_liquidation_amount(self, value):
        """Parse liquidation amount with enhanced handling for your format"""
        if isinstance(value, (int, float)):
            return float(value)
        if isinstance(value, str):
            value = value.strip().upper()
            multiplier = 1
            if 'K' in value:
                multiplier = 1e3
                value = value.replace('K', '')
            elif 'M' in value:
                multiplier = 1e6
                value = value.replace('M', '')
            elif 'B' in value:
                multiplier = 1e9
                value = value.replace('B', '')
            try:
                return float(value) * multiplier
            except ValueError:
                return 0.0
        return 0.0
    
    def merge_timeframes(self, dataframes):
        """Enhanced timeframe merging with dynamic weights (P1: Multi-TF Aggregation)"""
        timeframe_weights = {'12h': 0.35, '24h': 0.25, '48h': 0.20, '3d': 0.12, '1week': 0.08}
        merged_data = pd.DataFrame()
        
        for timeframe, df in dataframes.items():
            if not df.empty:
                weight = timeframe_weights[timeframe]
                df['weighted_leverage'] = df['liquidation_leverage'] * weight
                merged_data = pd.concat([merged_data, df], ignore_index=True)
        
        return merged_data


    def _parse_human_readable_number(self, value):
        """Parse human-readable numbers like '4.34M', '1.5K', '2.3B' to float."""
        if pd.isna(value):
            return np.nan
        if isinstance(value, (int, float)):
            return float(value)
        
        value_str = str(value).strip().upper()
        if not value_str:
            return np.nan
            
        multipliers = {
            'K': 1_000,
            'M': 1_000_000,
            'B': 1_000_000_000,
            'T': 1_000_000_000_000
        }
        
        # Check for suffix
        for suffix, multiplier in multipliers.items():
            if value_str.endswith(suffix):
                try:
                    return float(value_str[:-1]) * multiplier
                except ValueError:
                    return np.nan
        
        # No suffix, try direct conversion
        try:
            return float(value_str)
        except ValueError:
            return np.nan

    def preprocess_liquidation_data(self, df, timeframe):
        """Preprocess raw liquidation data from Google Sheets.
        
