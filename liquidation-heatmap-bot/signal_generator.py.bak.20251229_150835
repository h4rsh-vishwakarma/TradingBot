                    'cluster_width_bps': signal.get('cluster_width_bps', 0.0),
                    'cluster_intensity_z': signal.get('cluster_intensity_z', 0.0),
                    'regime_tag': signal.get('regime_tag', 'unknown'),
                    'stop_loss': signal.get('stop_loss'),
                    'take_profit': signal.get('take_profit')
                }
                self.open_positions_fifo.append(position_entry)
                pnl_open = 0.0
                pnl_close = 0.0
                logger.info(f"Position opened: {side} {filled_qty} @ ${filled_price:.2f} (edge={position_entry['edge_bps_at_entry']:.1f}bps, regime={position_entry['regime_tag']})")
            else:
                # Closing position - calculate realized PnL using FIFO
                pnl_close = self._calculate_realized_pnl(side, filled_qty, filled_price)
                pnl_open = 0.0
                close_reason = signal.get('exit_reason', 'UNKNOWN')
                logger.info(f"Position closed: {side} {filled_qty} @ ${filled_price:.2f}, PnL: ${pnl_close:.2f}, Reason: {close_reason}")
            
            logger.info(f"Logging fill event: order={order_id} qty={filled_qty} px={filled_price} pnl_close=${pnl_close:.2f}")
            logger.info(f"DEBUG: About to call emit_fill with order_id={order_id}, decision_id={decision_id}")
            
            self.emitters.emit_fill(
                fill_id=None,  # Auto-generated
                order_id=order_id,
                decision_id=decision_id,
                side=side,
                px=filled_price,
                qty=filled_qty,
                fee=0.0,  # Paper trading, no fees
                pnl_open=pnl_open,
                pnl_close=pnl_close,
                expected_px=signal.get('entry_price'),
                slippage_bps=None  # Will be auto-calculated from expected_px
            )
            logger.info(f"Fill event logged successfully: order={order_id} pnl_close=${pnl_close:.2f}")
        except Exception as e:
            logger.error(f"Failed to log fill event: {e}", exc_info=True)
    
    def _is_entry_order(self, side: str, qty: float) -> bool:
        """Determine if order is opening a new position or closing existing.
        
        Logic:
        - BUY increases LONG position (entry for LONG)
        - SELL decreases LONG position (exit for LONG)
        - SELL increases SHORT position (entry for SHORT)
        - BUY decreases SHORT position (exit for SHORT)
        
        Args:
            side: 'LONG' or 'SHORT' from signal direction
            qty: Order quantity
            
        Returns:
            True if entry, False if exit
        """
        # For simplicity in paper trading: side matches position type = entry
        # This assumes signals are always directional (LONG/SHORT)
        # BUY order for LONG signal = entry
        # SELL order for SHORT signal = entry
        # Opposite = exit
        
        # Count current positions by side
        long_qty = sum(p['qty'] for p in self.open_positions_fifo if p['side'] == 'LONG')
        short_qty = sum(p['qty'] for p in self.open_positions_fifo if p['side'] == 'SHORT')
        
        if side == 'LONG':
            # If we have no LONG positions, this is an entry
            return long_qty == 0
        else:  # SHORT
            # If we have no SHORT positions, this is an entry
            return short_qty == 0
    
    def _calculate_realized_pnl(self, side: str, qty: float, exit_price: float) -> float:
        """Calculate realized PnL using FIFO matching.
        
        Args:
            side: 'LONG' or 'SHORT' - the CLOSING side
            qty: Quantity being closed
            exit_price: Exit fill price
            
        Returns:
            Realized PnL in USD
        """
        pnl = 0.0
        remaining_qty = qty
        
        # FIFO: Close oldest positions first
        positions_to_remove = []
        
        for i, pos in enumerate(self.open_positions_fifo):
            if remaining_qty <= 0:
                break
            
            # Match opposite side (closing LONG means we had a LONG position)
            if pos['side'] != side:
                continue
            
            # How much of this position can we close?
            close_qty = min(remaining_qty, pos['qty'])
            
            # Calculate PnL for this partial close
            if side == 'LONG':
                # Closing LONG: profit when exit > entry
                pnl_for_partial = (exit_price - pos['entry_price']) * close_qty
            else:  # SHORT
                # Closing SHORT: profit when entry > exit
                pnl_for_partial = (pos['entry_price'] - exit_price) * close_qty
            
            pnl += pnl_for_partial
            remaining_qty -= close_qty
            
            # Update position quantity
            pos['qty'] -= close_qty
            
            # Mark for removal if fully closed
            if pos['qty'] <= 0.0001:  # Floating point tolerance
                positions_to_remove.append(i)
        
        # Remove fully closed positions (reverse order to preserve indices)
        for i in reversed(positions_to_remove):
            removed_pos = self.open_positions_fifo.pop(i)
            logger.info(f"Position fully closed: {removed_pos['side']} entry=${removed_pos['entry_price']:.2f}")
            
            # Emit TradeSummary for closed position
            try:
                if self.emitters and hasattr(self.emitters, 'llm_emitter'):
                    from observability.emitters.llm_summary_emitter import TradeSummary
                    
                    # Calculate trade metrics
                    duration_s = (datetime.now(timezone.utc) - removed_pos['entry_time']).total_seconds()
                    
                    # Calculate pnl_bps using the closing qty (not removed_pos['qty'] which is now 0)
                    # Use the pnl directly since it was calculated for the closed amount
                    position_value = removed_pos['entry_price'] * qty  # qty is the amount we just closed
                    pnl_bps = (pnl / position_value) * 10000 if position_value > 0 else 0.0
                    
                    # Calculate R-multiple if stop_loss available
                    r_multiple = None
                    if removed_pos.get('stop_loss') and removed_pos['entry_price'] > 0:
                        risk_per_unit = abs(removed_pos['entry_price'] - removed_pos['stop_loss'])
                        if risk_per_unit > 0:
                            r_multiple = pnl / (risk_per_unit * qty)  # Use closing qty, not removed_pos['qty']
                    
                    trade_summary = TradeSummary(
                        ts_open=removed_pos['entry_time'].isoformat(),
                        ts_close=datetime.now(timezone.utc).isoformat(),
                        decision_id=removed_pos.get('decision_id', ''),
                        side=removed_pos['side'],
                        entry_px=removed_pos['entry_price'],
                        exit_px=exit_price,
                        qty=qty,  # Use actual closing qty
                        pnl_usd=pnl,
                        r_multiple=r_multiple,
                        edge_bps_at_entry=removed_pos.get('edge_bps_at_entry', 0.0),
                        cluster_width_bps=removed_pos.get('cluster_width_bps', 0.0),
                        cluster_intensity_z=removed_pos.get('cluster_intensity_z', 0.0),
                        regime_tag=removed_pos.get('regime_tag', 'unknown'),
                        exit_reason=exit_reason,  # 'stop_loss', 'take_profit', or 'manual'
                        hold_duration_s=duration_s
                    )
                    
                    self.emitters.llm_emitter.emit_trade(trade_summary)
                    logger.info(f"📊 TradeSummary emitted: PnL=${pnl:.2f} ({pnl_bps:.1f}bps), R={r_multiple:.2f if r_multiple else 'N/A'}, duration={duration_s:.0f}s")
            except Exception as e:
                logger.error(f"Failed to emit TradeSummary: {e}")
        
        # P3: Calculate and log slippage
        slippage_bps = 0.0
        if removed_pos.get('decision_id') and removed_pos['entry_price'] > 0:
            expected_entry = removed_pos.get('expected_entry_price', removed_pos['entry_price'])
            slippage_bps = ((removed_pos['entry_price'] - expected_entry) / expected_entry) * 10000
            if abs(slippage_bps) > 0.1:  # Only log if meaningful
                logger.info(f"📊 Slippage: {slippage_bps:.2f} BPS (expected=${expected_entry:.2f}, actual=${removed_pos['entry_price']:.2f})")
        
        # Update total realized PnL
        self.total_realized_pnl += pnl
        
        return pnl

