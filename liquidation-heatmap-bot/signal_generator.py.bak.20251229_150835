    def execute_live_trade(self, signal):
        """Execute trade on Binance Futures"""
        if not self.binance_client:
            logger.error("Binance Client not initialized")
            return

        try:
            symbol = 'BTCUSDT'
            side = signal['direction'].upper()
            quantity = round(signal['position_size'], 3)
            
            # Market order for entry
            logger.info(f"LIVE: Placing {side} order for {quantity} BTC")
            order = self.binance_client.futures_create_order(
                symbol=symbol,
                side=side,
                type='MARKET',
                quantity=quantity
            )
            logger.info(f"LIVE ORDER EXECUTED: {order}")
            
            # Place Stop Loss
            sl_side = 'SELL' if side == 'BUY' else 'BUY'
            try:
                self.binance_client.futures_create_order(
                    symbol=symbol,
                    side=sl_side,
                    type='STOP_MARKET',
                    stopPrice=round(signal['stop_loss'], 2),
                    closePosition=True
                )
                logger.info(f"LIVE: Stop Loss placed at {signal['stop_loss']}")
            except Exception as e:
                logger.error(f"Failed to place Stop Loss: {e}")

            # Place Take Profit
            try:
                self.binance_client.futures_create_order(
                    symbol=symbol,
                    side=sl_side,
                    type='TAKE_PROFIT_MARKET',
                    stopPrice=round(signal['take_profit'], 2),
                    closePosition=True
                )
                logger.info(f"LIVE: Take Profit placed at {signal['take_profit']}")
            except Exception as e:
                logger.error(f"Failed to place Take Profit: {e}")
            
            # Log fill
            avg_price = float(order.get('avgPrice', signal['entry_price']))
            if avg_price == 0:
                avg_price = signal['entry_price']
            self._log_fill_event(signal, quantity, avg_price)
            
        except BinanceAPIException as e:
            logger.error(f"Binance API Error: {e}")
            self._log_error_event('live_execution', 'CRITICAL', str(e))
        except Exception as e:
            logger.error(f"Live execution error: {e}")

    def execute_enhanced_signal(self, signal):
        """Execute enhanced signal with full risk management"""
        try:
            if self.kill_switch_active:
                logger.warning("Kill switch active - execution skipped")
                return
            # Emoji execution banner
            logger.info(f"🟢 EXECUTING ENHANCED SIGNAL: {signal['direction']} {signal['type']}")
            # Extract market features for RL
            market_features = {
                'volatility': signal.get('volatility_regime', 'normal'),
                'regime': signal.get('market_regime', 'ranging'),
                'multi_tf_score': signal.get('multi_tf_score', 0),
                'cluster_density': signal.get('cluster_density', 0),
                'cluster_strength': signal.get('cluster_strength', 0)
            }
            
            # Get RL confidence if available
            if self.rl_system:
                rl_confidence = self.rl_system.predict_confidence(market_features, signal)
                # Clamp RL confidence to [0, 1] range
                rl_conf_clamped = max(0.0, min(1.0, rl_confidence))
                combined_confidence = (signal['confidence'] * 0.7) + (rl_conf_clamped * 0.3)
            else:
                # No RL system, use signal confidence directly
                combined_confidence = signal['confidence']
            
            # Check if signal meets minimum confidence threshold
            if combined_confidence < self.trading_config.min_confidence_threshold:
                logger.info(f"Signal rejected: confidence {combined_confidence:.2f} < threshold {self.trading_config.min_confidence_threshold}")
                # Low confidence is not a system failure - it's the strategy working correctly
                logger.debug(f"Low confidence rejection - not counting as failure (streak: {self.risk_rejection_streak})")
                return
            
            # === CANONICAL INTEGRATION POINT: STOP_LOSS_MANAGER ===
            # ⚠️ CRITICAL ORDER: Calculate stop/TP FIRST, THEN validate
            # Raw signal validated for edge/confidence, NOW compute commission-safe stop/TP/position size
            logger.info(f"🔧 INTEGRATING STOP_LOSS_MANAGER: Converting raw signal → tradable trade")
            
            # Update daily PnL for sizing
            current_daily_pnl = self.risk_manager.get_total_daily_pnl(self.current_price)
            self.risk_manager.position_sizer.daily_pnl = current_daily_pnl
            
            # Step 1: Calculate position size (needed for risk calculation)
            # Use cluster suggestion for initial sizing
            cluster_stop_temp = signal.get('cluster_stop_suggestion')
            if not cluster_stop_temp:
                # Fallback: 1% stop for sizing estimate
                cluster_stop_temp = signal['entry_price'] * (0.99 if signal['direction'] == 'LONG' else 1.01)
            
            # P2 FIX: Build complete signal_data with cluster_quality and data_quality
            # Extract cluster_quality from signal - handle both dict and Series/None cases
            cluster_quality = 0.5  # Default
            cluster_obj = signal.get('cluster')
            logger.info(f"🔍 P2 DEBUG: cluster_obj type={type(cluster_obj)}, is_none={cluster_obj is None}")
            if cluster_obj is not None:
                if isinstance(cluster_obj, dict):
                    cluster_quality = cluster_obj.get('cluster_quality', 0.5)
                    logger.info(f"🔍 P2 DEBUG: Extracted from dict: cluster_quality={cluster_quality}, keys={list(cluster_obj.keys())[:5]}")
                elif hasattr(cluster_obj, 'get'):  # pandas Series or similar
                    cluster_quality = float(cluster_obj.get('cluster_quality', 0.5))
                    logger.info(f"🔍 P2 DEBUG: Extracted from Series: cluster_quality={cluster_quality}")
                elif hasattr(cluster_obj, 'cluster_quality'):  # Object with attribute
                    cluster_quality = float(cluster_obj.cluster_quality)
                    logger.info(f"🔍 P2 DEBUG: Extracted from attribute: cluster_quality={cluster_quality}")
            
            signal_data_temp = {
                'direction': signal['direction'],
                'entry_price': signal['entry_price'],
                'stop_loss': cluster_stop_temp,
                'confidence': signal['confidence'],
                'cluster_quality': cluster_quality,
                'data_quality_score': 1.0  # Full quality if all checks passed
            }
            
            # P2 FIX: Build complete market_features with multi_timeframe data for MTF alignment scaling
            atr = signal.get('atr', signal['entry_price'] * 0.01)
            market_features_temp = {
                'volatility': signal.get('volatility_regime', 'NORMAL'),
                'atr': atr,
                'multi_timeframe': {
                    '15m_trend': 0,  # Will be populated if available
                    '1h_trend': 0,
                    '4h_trend': 0
                }
            }
            
            # Extract MTF data if available in signal
            if signal.get('multi_tf_score') is not None:
                # Try to extract individual timeframe trends from the signal
                # Note: These aren't directly in signal dict, but we can use overall score as proxy
                mtf_score = signal['multi_tf_score']
                # Use overall score as proxy for all timeframes
                market_features_temp['multi_timeframe'] = {
                    '15m_trend': mtf_score,
                    '1h_trend': mtf_score,
                    '4h_trend': mtf_score
                }
            
            try:
                position_size = self.risk_manager.calculate_position_size(
                    signal_data_temp, market_features_temp, self.current_balance
                )
            except Exception as e:
                logger.warning(f"Risk manager position sizing failed: {e}, using fallback")
                position_size = (self.current_balance * 0.10) / signal['entry_price']
            
            # Step 2: Initialize stop_loss_manager if needed
            if not hasattr(self, 'stop_loss_manager'):
                from stop_loss_manager import StopLossManager
                self.stop_loss_manager = StopLossManager(self.trading_config)
                logger.info("✅ StopLossManager initialized")
            
            # Step 3: Compute commission-safe stop loss and take profit
            # This will AUTO-WIDEN cluster stops if they produce <$1.00 risk
            try:
                sl_result = self.stop_loss_manager.calculate_stop_loss_take_profit(
                    entry_price=signal['entry_price'],
                    bias=signal['direction'],
                    position_size_btc=position_size,
                    cluster_stop=signal.get('cluster_stop_suggestion'),
                    atr=atr,
                    opposing_cluster_price=signal.get('opposing_cluster_suggestion')
                )
                
                stop_loss = sl_result.stop_loss
                take_profit = sl_result.take_profit
                
                # Log stop-loss decision (widened or validated)
                if sl_result.was_widened:
                    logger.warning(
                        f"🔧 STOP AUTO-WIDENED: ${sl_result.initial_risk:.2f} → ${sl_result.risk_usd:.2f} | "
                        f"Reason: {sl_result.widen_reason}"
                    )
                else:
                    logger.info(
                        f"✅ Stop validated: SL=${stop_loss:.2f}, risk=${sl_result.risk_usd:.2f}, source={sl_result.source}"
                    )
                
                logger.info(
                    f"📊 FINAL TRADE PARAMETERS: entry=${signal['entry_price']:.2f}, sl=${stop_loss:.2f}, "
                    f"tp={take_profit:.2f}, qty={position_size:.4f}, risk=${sl_result.risk_usd:.2f}"
                )
                
            except Exception as e:
                # HARD STOP: If stop_loss_manager fails, DO NOT create trade
                logger.error(f"❌ STOP_LOSS_MANAGER FAILED: {e} | Trade VETOED", exc_info=True)
                self.risk_rejection_streak += 1
                if self.risk_rejection_streak >= 50:  # Increased from 10 to 50 - actual system failures
                    self.trigger_kill_switch('stop_loss_manager_failures')
                return  # 🚫 REJECT TRADE
            # Log bracket event early
            self._log_bracket_event(signal, stop_loss, take_profit)
            
            # Calculate risk metrics
            risk_per_share = abs(signal['entry_price'] - stop_loss)
            rr_ratio = abs(take_profit - signal['entry_price']) / risk_per_share
            
            # Allow R/R >= 1.8 (slightly below 2.0 to account for rounding and auto-widening)
            min_rr = 1.8
            if rr_ratio < min_rr:
                logger.info(f"Signal rejected: R/R ratio {rr_ratio:.2f} < {min_rr}")
                # Low R/R is not a system failure - it's risk management working correctly
                logger.debug(f"R/R ratio check - valid risk management (streak unchanged: {self.risk_rejection_streak})")
                return
            
            # Extract cluster_quality from signal for risk scaling
            target_cluster = signal.get('target_cluster')
            cluster_quality = 0.5  # Default medium quality
            if target_cluster is not None and isinstance(target_cluster, dict):
                cluster_quality = float(target_cluster.get('cluster_quality', 0.5))
            
            # Classify playbook: FADE (mean-reversion) or BREAK (momentum)
            # FADE: Entry near cluster expecting bounce/rejection
            # BREAK: Entry through cluster expecting momentum continuation
            playbook = 'FADE'  # Default to fade (most liquidation plays are mean-reversion)
            if target_cluster is not None:
                cluster_distance_bps = abs(target_cluster.get('mean_price', self.current_price) - self.current_price) / self.current_price * 10000
                # If price is very close to cluster (< 10 bps) and MTF aligned, it's a BREAK
                if cluster_distance_bps < 10 and multi_tf_signals and abs(multi_tf_signals.get('overall_score', 0)) > 0.6:
                    playbook = 'BREAK'
            
            # Compute data_quality_score (0-1) from staleness metrics
            data_quality_score = self._compute_data_quality_score()
            
            # Create enhanced signal
            enhanced_signal = {
                **signal,
                'rl_confidence': rl_confidence,
                'combined_confidence': combined_confidence,
                'stop_loss': stop_loss,
                'take_profit': take_profit,
                'position_size': position_size,
                'quantity': position_size,  # Add for validators
                'rr_ratio': rr_ratio,
                'cluster_quality': cluster_quality,  # NEW: Quality score for risk scaling
                'data_quality_score': data_quality_score,  # NEW: Staleness-based quality
                'playbook': playbook,  # NEW: FADE or BREAK strategy classification
