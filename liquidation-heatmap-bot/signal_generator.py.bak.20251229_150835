    def _log_decision_event(self, direction, action, bias_reason, confidence, oi_signal, funding_signal, clusters_count, multi_tf, signal=None, votes=None):
        if metrics.PROM_AVAILABLE:
            try: metrics.decisions_counter.labels(direction=str(direction), action=action).inc()
            except Exception: pass
        
        # Extract edge_bps from signal if available
        edge_bps = signal.get('edge_bps') if signal else None
        edge_ok = signal.get('edge_ok', False) if signal else False
        
        # Calculate signal strength scores from votes
        # S_long/S_short represent pure vote strength (0-1), not scaled by confidence
        S_long = 0.0
        S_short = 0.0
        if votes:
            long_votes = sum(1 for v in votes.values() if v == 'LONG')
            short_votes = sum(1 for v in votes.values() if v == 'SHORT')
            # Normalize to 0-1 scale based on vote proportion
            S_long = long_votes / 3.0
            S_short = short_votes / 3.0
        
        # Format votes for emit_decision (expects keys: m1, m2, m3)
        formatted_votes = None
        if votes:
            formatted_votes = {
                'm1': votes.get('m1_proximity', 'NONE'),
                'm2': votes.get('m2_density', 'NONE'),
                'm3': votes.get('m3_sentiment', 'NONE')
            }
        
        # Extract cluster data from signal
        cluster_data = {}
        if signal:
            # Get cluster price range (tuple of (lower, upper))
            if 'cluster' in signal and isinstance(signal['cluster'], (tuple, list)) and len(signal['cluster']) == 2:
                cluster_data['price_range'] = {
                    'lower': float(signal['cluster'][0]),
                    'upper': float(signal['cluster'][1])
                }
            # Get cluster metrics (only add if non-zero/meaningful)
            if signal.get('cluster_distance_bps') is not None and signal.get('cluster_distance_bps') != 0:
                cluster_data['distance_bps'] = float(signal['cluster_distance_bps'])
            if signal.get('cluster_width_bps') is not None and signal.get('cluster_width_bps') != 0:
                cluster_data['width_bps'] = float(signal['cluster_width_bps'])
            if signal.get('cluster_intensity_z') is not None and signal.get('cluster_intensity_z') != 0:
                cluster_data['intensity_z'] = float(signal['cluster_intensity_z'])
            if signal.get('cluster_size_usd') is not None and signal.get('cluster_size_usd') != 0:
                cluster_data['size_usd'] = float(signal['cluster_size_usd'])
            if signal.get('cluster_density') is not None and signal.get('cluster_density') != 0:
                cluster_data['density'] = float(signal['cluster_density'])
            if signal.get('cluster_strength') is not None and signal.get('cluster_strength') != 0:
                cluster_data['strength'] = int(signal['cluster_strength'])
            if signal.get('cluster_type'):
                cluster_data['type'] = signal['cluster_type']
            
            # Log cluster metrics for debugging
            if cluster_data:
                logger.debug(f"📊 Cluster data in decision: {cluster_data}")
        
        # Prepare context for LLM
        context = {
            'direction': direction,
            'action': action,
            'bias_reason': bias_reason,
            'confidence': confidence,
            'oi_signal': oi_signal,
            'funding_signal': funding_signal,
