    def _start_heartbeat(self):
        """Start background heartbeat thread."""
        self._heartbeat_running = True
        self._heartbeat_thread = threading.Thread(target=self._heartbeat_loop, daemon=True)
        self._heartbeat_thread.start()

    def _heartbeat_loop(self):
        """Periodic heartbeat logging and metric updates."""
        while self._heartbeat_running:
            try:
                time.sleep(self.heartbeat_interval)
                now = datetime.now(timezone.utc)
                
                # Check if kill switch should auto-reset
                self.check_kill_switch_auto_reset()
                
                # Log heartbeat
                price_age = (now - self.last_price_update_time).total_seconds() if self.last_price_update_time else -1
                cluster_age = (now - self.last_cluster_update_time).total_seconds() if self.last_cluster_update_time else -1
                
                price_str = f"${self.current_price:,.2f}" if self.current_price is not None else "N/A"
                balance_str = f"${self.current_balance:,.2f}" if self.current_balance is not None else "N/A"
                logger.info(f"💓 HEARTBEAT: Price={price_str} | PriceAge={price_age:.1f}s | ClusterAge={cluster_age:.1f}s | Balance={balance_str}")
                
                # Update metrics
                if metrics.PROM_AVAILABLE:
                    try:
                        if price_age >= 0 and hasattr(metrics, 'price_age_gauge') and metrics.price_age_gauge:
                            metrics.price_age_gauge.set(price_age)
                        if cluster_age >= 0 and hasattr(metrics, 'heatmap_age_gauge') and metrics.heatmap_age_gauge:
                            metrics.heatmap_age_gauge.set(cluster_age)
                        # Update positions gauge
                        positions_open = len(getattr(self.risk_manager, 'current_positions', []) or [])
                        if hasattr(metrics, 'positions_open_gauge') and metrics.positions_open_gauge:
                            metrics.positions_open_gauge.set(positions_open)
                        # Update risk used gauge (based on daily cap usage)
                        start_eq = getattr(self.risk_manager, 'start_of_day_equity', None) or 0
                        cap_pct = getattr(self.risk_manager, 'daily_cap_pct', None) or 0
                        total_daily_pnl = 0.0
                        try:
                            total_daily_pnl = self.risk_manager.get_total_daily_pnl(self.current_price or 0)
                        except Exception:
                            total_daily_pnl = getattr(self.risk_manager, 'daily_pnl', 0.0)
                        risk_used = 0.0
                        if start_eq > 0 and cap_pct > 0:
                            loss = max(0.0, -float(total_daily_pnl))
                            denom = float(start_eq) * float(cap_pct)
                            if denom > 0:
                                risk_used = min(1.0, loss / denom)
                        if hasattr(metrics, 'risk_used_pct_gauge') and metrics.risk_used_pct_gauge:
                            metrics.risk_used_pct_gauge.set(risk_used)
                        # Check for daily cap hit
                        if risk_used >= 1.0 or getattr(self.risk_manager, 'daily_cap_breached', False):
                            if hasattr(metrics, 'risk_daily_cap_hits_counter') and metrics.risk_daily_cap_hits_counter:
                                metrics.risk_daily_cap_hits_counter.inc()
                        # Update reconnects counter
                        reconnects = self.binance_ws.reconnect_count
                        if reconnects > self._last_ws_reconnects_reported:
                            if hasattr(metrics, 'ws_reconnects_counter') and metrics.ws_reconnects_counter:
                                metrics.ws_reconnects_counter.inc(reconnects - self._last_ws_reconnects_reported)
                            self._last_ws_reconnects_reported = reconnects
                    except Exception as e:
                        logger.error(f"Error updating heartbeat metrics: {e}")
                
                # Emit heartbeat event
                if self.emitters:
                    try:
                        # Derive risk usage and fields safely
                        positions_open = len(getattr(self.risk_manager, 'current_positions', []) or [])
                        start_eq = getattr(self.risk_manager, 'start_of_day_equity', None) or 0
                        cap_pct = getattr(self.risk_manager, 'daily_cap_pct', None) or 0
                        total_daily_pnl = 0.0
                        try:
                            total_daily_pnl = self.risk_manager.get_total_daily_pnl(self.current_price or 0)
                        except Exception:
                            total_daily_pnl = getattr(self.risk_manager, 'daily_pnl', 0.0)
                        risk_used = 0.0
                        if start_eq > 0 and cap_pct > 0:
                            loss = max(0.0, -float(total_daily_pnl))
                            denom = float(start_eq) * float(cap_pct)
                            if denom > 0:
                                risk_used = min(1.0, loss / denom)
                        
                        # Calculate daily loss (P1 improvement)
                        daily_loss_usd = max(0.0, -total_daily_pnl) if total_daily_pnl < 0 else 0.0
                        
                        # Calculate risk metrics (P0 improvements)
                        initial_balance = self.trading_config.initial_balance
                        risk_remaining_usd = max(0.0, initial_balance * cap_pct - daily_loss_usd) if cap_pct > 0 else None
                        
                        # Get per-position risk amounts - return empty list instead of None
                        risk_per_position_usd = []
                        if self.paper_simulator and hasattr(self.paper_simulator, 'positions'):
                            risk_per_position_usd = [
                                abs(pos.entry_price - pos.stop_loss) * pos.size 
                                for pos in self.paper_simulator.positions
                                if hasattr(pos, 'entry_price') and hasattr(pos, 'stop_loss') and hasattr(pos, 'size')
                            ] if self.paper_simulator.positions else []
                        
                        # Calculate WS and REST price ages separately (P0)
                        price_age_s_ws = None
                        price_age_s_rest = None
                        if self.last_price_update_time:
                            # We primarily use WS, so price_age is WS age
                            price_age_s_ws = price_age if price_age >= 0 else None
                            # REST age: check if we have REST polling enabled
                            # For now, mark as 0 to indicate "not applicable" vs "stale"
                            price_age_s_rest = 0.0  # 0 = REST not used, None = unknown
                        
                        # Get daily cap hit timestamp if available
                        daily_cap_hit = getattr(self.risk_manager, 'daily_cap_breached', False)
                        daily_cap_hit_ts = None
                        if daily_cap_hit and hasattr(self.risk_manager, 'daily_cap_hit_time'):
                            daily_cap_hit_ts = getattr(self.risk_manager, 'daily_cap_hit_time', None)
                        
                        # Calculate unrealized PnL from open positions
                        unrealized_pnl = 0.0
                        try:
                            for pos in self.open_positions_fifo:
                                if pos['side'] == 'LONG':
                                    unrealized_pnl += (self.current_price - pos['entry_price']) * pos['qty']
                                else:  # SHORT
                                    unrealized_pnl += (pos['entry_price'] - self.current_price) * pos['qty']
                        except Exception as e:
                            logger.debug(f"Unrealized PnL calculation error: {e}")
                        
                        # Calculate total equity (realized balance + unrealized PnL)
                        total_equity = (self.current_balance or 0.0) + unrealized_pnl
                        
                        self.emitters.emit_health(
                            price_age_s=price_age if price_age >= 0 else None,
                            price_age_s_ws=price_age_s_ws,
                            price_age_s_rest=price_age_s_rest,
                            heatmap_age_s=cluster_age if cluster_age >= 0 else None,
                            ws_connected=self.binance_ws.running,
                            coinglass_ok=True,
                            positions_open=positions_open,
                            risk_used_pct=risk_used,
                            risk_remaining_usd=risk_remaining_usd,
                            daily_cap_hit=daily_cap_hit,
                            daily_cap_hit_ts=daily_cap_hit_ts,
                            kill_switch_active=self.kill_switch_active,
                            kill_switch_reason=self.kill_switch_reason if self.kill_switch_active else None,
                            kill_switch_trigger_ts=getattr(self, 'kill_switch_trigger_ts', None),
                            equity_usd=total_equity,
                            pnl_realized_usd=self.total_realized_pnl,
                            pnl_unrealized_usd=unrealized_pnl,
                            risk_per_position_usd=risk_per_position_usd if risk_per_position_usd else None,
                            daily_pnl=total_daily_pnl,
                            daily_loss_usd=daily_loss_usd
                        )
                    except Exception as e:
                        logger.error(f"Heartbeat emit error: {e}")
                        
            except Exception as e:
                logger.error(f"Heartbeat error: {e}")
                time.sleep(5)  # prevent tight loop on error

