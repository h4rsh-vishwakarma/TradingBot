    async def check_websocket_health(self) -> bool:
        """Check WebSocket connection health; restart if stale or disconnected."""
        try:
            # Connection state
            self.ws_connected = self.binance_ws.running
            if not self.ws_connected:
                logger.warning("WebSocket disconnected - restarting...")
                await self.restart_websocket()
                return False
            # Price freshness
            if self.last_price_update_time:
                price_age = (datetime.now(timezone.utc) - self.last_price_update_time).total_seconds()
                stale_limit = int(os.getenv('WS_PRICE_STALE_SECONDS','10'))
                if price_age > stale_limit:
                    logger.warning(f"WebSocket stale ({price_age:.1f}s > {stale_limit}s) - restarting")
                    await self.restart_websocket()
                    return False
            else:
                logger.warning("No price updates yet - restarting WebSocket")
                await self.restart_websocket()
                return False
            return True
        except Exception as e:
            logger.error(f"WebSocket health check error: {e}")
            return False

    async def restart_websocket(self, retry_count: int = 0, max_retries: int = 3):
        """Force restart underlying WebSocket client with limited retries."""
        try:
            self.binance_ws.stop()
            await asyncio.sleep(1)
            self.binance_ws.start()
            # Allow some time for first price
            await asyncio.sleep(2)
            self.ws_connected = self.binance_ws.running
            if self.ws_connected:
                logger.info("WebSocket restarted successfully")
            else:
                raise RuntimeError("WebSocket not running after restart")
        except Exception as e:
            logger.error(f"WebSocket restart failed: {e}")
            if retry_count < max_retries:
                backoff = 2 ** retry_count
                logger.info(f"Retrying WebSocket restart in {backoff}s (attempt {retry_count+1}/{max_retries})")
                await asyncio.sleep(backoff)
                await self.restart_websocket(retry_count + 1, max_retries)
            else:
                logger.error("Max WebSocket restart attempts exceeded")

