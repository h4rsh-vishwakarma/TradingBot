    def identify_clusters(self, df):
        """Enhanced cluster identification"""
        if df.empty or 'price' not in df.columns or len(df) < 3:
            logger.warning(f"identify_clusters: Early return - empty={df.empty}, has_price={'price' in df.columns}, len={len(df)}")
            return pd.DataFrame()

        # Log data stats for debugging
        logger.info(f"identify_clusters: Processing {len(df)} data points")
        logger.info(f"identify_clusters: Price range ${df['price'].min():.2f} - ${df['price'].max():.2f}")
        logger.info(f"identify_clusters: weighted_leverage range {df['weighted_leverage'].min():.2f} - {df['weighted_leverage'].max():.2f}, sum={df['weighted_leverage'].sum():.2f}")
        logger.info(f"identify_clusters: cluster_width_threshold={self.trading_config.cluster_width_threshold}, min_cluster_points={self.trading_config.min_cluster_points}, cluster_density_threshold={self.trading_config.cluster_density_threshold}")

        df_sorted = df.sort_values('price').reset_index(drop=True)
        prices_sorted = df_sorted['price'].values
        
        clusters = []
        i = 0
        while i < len(prices_sorted):
            current_price = prices_sorted[i]
            band = current_price * self.trading_config.cluster_width_threshold
            
            in_cluster_mask = (prices_sorted >= current_price) & (prices_sorted <= current_price + band)
            in_cluster_df = df_sorted[in_cluster_mask]
            
            cluster_value = in_cluster_df['weighted_leverage'].sum()
            
            # Check if this qualifies as a cluster
            meets_points = len(in_cluster_df) >= self.trading_config.min_cluster_points
            meets_density = cluster_value >= self.trading_config.cluster_density_threshold
            
            if meets_points and meets_density:
                
                long_liq = in_cluster_df[in_cluster_df.get('liquidation_type', 'mixed') == 'long']['weighted_leverage'].sum()
                short_liq = in_cluster_df[in_cluster_df.get('liquidation_type', 'mixed') == 'short']['weighted_leverage'].sum()
                total_liq = long_liq + short_liq
                
                long_ratio = long_liq / total_liq if total_liq > 0 else 0.5
                short_ratio = short_liq / total_liq if total_liq > 0 else 0.5
                
                if long_ratio > 0.7:
                    cluster_type = 'LONG_HEAVY'
                elif short_ratio > 0.7:
                    cluster_type = 'SHORT_HEAVY'
                else:
                    cluster_type = 'MIXED'
                
                price_density = cluster_value / (in_cluster_df['price'].max() - in_cluster_df['price'].min() + 1e-6)
                
                # Compute cluster_quality_score (0-1) for risk scaling
                # Based on: 1) normalized density, 2) price_density (strength), 3) data point count
                median_density = df_sorted['weighted_leverage'].sum() / max(len(df_sorted), 1)
                liquidity_factor = min(cluster_value / max(median_density, 1e-6), 3.0) / 3.0  # 0-1, capped at 3x median
                strength_factor = min(price_density / 1000.0, 1.0)  # Normalize by typical strength ~1000
                data_point_factor = min(len(in_cluster_df) / 10.0, 1.0)  # More points = higher quality, cap at 10
                
                cluster_quality = (liquidity_factor * 0.4 + strength_factor * 0.4 + data_point_factor * 0.2)
                cluster_quality = max(0.1, min(cluster_quality, 1.0))  # Clamp to [0.1, 1.0]
                
                clusters.append({
                    'mean_price': np.average(in_cluster_df['price'], weights=in_cluster_df['weighted_leverage']),
                    'min_price': in_cluster_df['price'].min(),
                    'max_price': in_cluster_df['price'].max(),
                    'density': cluster_value,
                    'width': in_cluster_df['price'].max() - in_cluster_df['price'].min(),
                    'strength_score': price_density,
                    'data_points': len(in_cluster_df),
                    'cluster_type': cluster_type,
                    'long_ratio': long_ratio,
                    'short_ratio': short_ratio,
                    'cluster_quality': cluster_quality  # NEW: Quality score for risk scaling
                })
                
                i = in_cluster_df.index[-1] + 1
            else:
                i += 1
        
        if clusters:
            clusters_df = pd.DataFrame(clusters)
            strength_threshold = clusters_df['strength_score'].quantile(0.5)
            return clusters_df[clusters_df['strength_score'] >= strength_threshold].sort_values('density', ascending=False)
        return pd.DataFrame()

    def analyze_oi_trend(self, oi_data, current_price):
        """Enhanced OI trend analysis for format: Timestamp (UTC),Open Interest (USD),BTC Price (USD)"""
        logger.info(f"OI Analysis: Received {len(oi_data) if not oi_data.empty else 0} rows")
        if oi_data.empty or len(oi_data) < 2:  # Reduced requirement from 5 to 2
            return "NEUTRAL", f"Insufficient OI data ({len(oi_data) if not oi_data.empty else 0} rows, need 2+)"
        
        # Handle exact column names from your format
        oi_col = 'Open Interest (USD)'
        price_col = 'BTC Price (USD)'
        
        # Check if columns exist
        if oi_col not in oi_data.columns or price_col not in oi_data.columns:
            return "NEUTRAL", f"Missing OI columns. Found: {list(oi_data.columns)}"
        
        try:
            recent_oi = pd.to_numeric(oi_data[oi_col].tail(10), errors='coerce').dropna()
            recent_prices = pd.to_numeric(oi_data[price_col].tail(10), errors='coerce').dropna()
            
            if len(recent_oi) < 2 or len(recent_prices) < 2:
                return "NEUTRAL", "Insufficient valid OI data"
            
            latest_oi = recent_oi.iloc[-1]
            prev_oi = recent_oi.iloc[-5] if len(recent_oi) >= 5 else recent_oi.iloc[0]
            oi_change = (latest_oi - prev_oi) / prev_oi if prev_oi > 0 else 0
            
            latest_price = recent_prices.iloc[-1]
            prev_price = recent_prices.iloc[-5] if len(recent_prices) >= 5 else recent_prices.iloc[0]
            price_change = (latest_price - prev_price) / prev_price if prev_price > 0 else 0
            
            # Enhanced analysis with realistic thresholds (1% based on 95th percentile = 0.93%)
            oi_threshold = 0.01  # 1% - catches strong moves (was 5% = impossible)
            price_threshold = 0.005  # 0.5% - meaningful price move
            
            # Positive OI changes
            if oi_change > oi_threshold and price_change > price_threshold:
                return "BULLISH", f"Rising OI ({oi_change:.2%}) + Rising Price ({price_change:.2%})"
            elif oi_change > oi_threshold and price_change < -price_threshold:
                return "BEARISH", f"Rising OI ({oi_change:.2%}) + Falling Price ({price_change:.2%})"
            # Negative OI changes (capitulation/profit-taking)
            elif oi_change < -oi_threshold and price_change < -price_threshold:
                return "BEARISH", f"Capitulation: OI falling ({oi_change:.2%}) with price ({price_change:.2%})"
            elif oi_change < -oi_threshold and price_change > price_threshold:
                return "BULLISH", f"Profit-taking: OI falling ({oi_change:.2%}), price rising ({price_change:.2%})"
            # Neutral range
            else:
                return "NEUTRAL", f"Stable OI ({oi_change:.2%}), price ({price_change:.2%})\""
                
        except Exception as e:
            logger.error(f"Error analyzing OI data: {e}")
            return "NEUTRAL", "OI analysis error"
    
