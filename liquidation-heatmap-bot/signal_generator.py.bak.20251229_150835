    def _start_data_loading(self):
        """Start background data loading thread."""
        self._data_running = True
        self._data_thread = threading.Thread(target=self._data_loading_loop, daemon=True)
        self._data_thread.start()
        logger.info("Async data loading thread started")

    def _data_loading_loop(self):
        """Periodic data loading loop running in background thread."""
        while self._data_running:
            try:
                # Calculate sleep time
                refresh_interval = self.trading_config.data_refresh_minutes * 60
                # Add some jitter to avoid synchronized API hits if running multiple instances
                sleep_time = refresh_interval + random.uniform(-5, 5)
                
                # Sleep in small chunks to allow faster shutdown
                chunks = int(sleep_time / 1)
                for _ in range(chunks):
                    if not self._data_running:
                        return
                    time.sleep(1)
                time.sleep(sleep_time % 1)
                
                if not self._data_running:
                    break
                    
                logger.info("Async: Starting data refresh...")
                self.load_all_data()
                self.last_data_load_time = datetime.now(timezone.utc)
                logger.info("Async: Data refresh complete")
                
            except Exception as e:
                logger.error(f"Error in data loading loop: {e}")
                # Wait a bit before retrying to avoid tight loop on persistent error
                time.sleep(60)



