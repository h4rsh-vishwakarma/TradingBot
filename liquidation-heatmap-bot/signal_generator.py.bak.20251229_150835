        if not self.emitters:
            logger.error("CRITICAL: Emitters not available for order logging - self.emitters is None!")
            return
        
        try:
            # Generate unique order ID
            order_id = f"ord_{uuid.uuid4().hex[:8]}"
            decision_id = signal.get('decision_id', '')
            
            # Map direction to order side
            side = 'BUY' if signal['direction'] == 'LONG' else 'SELL'
            
            # Paper trading: orders execute immediately, so status is FILLED not NEW
            status = 'FILLED' if executed else 'REJECTED'
            
            logger.info(f"Logging order event: {order_id} {side} {status} qty={signal['position_size']} px={signal['entry_price']}")
            logger.info(f"DEBUG: About to call emit_order with order_id={order_id}, decision_id={decision_id}")
            
            self.emitters.emit_order(
                order_id=order_id,
                decision_id=decision_id,
                side=side,
                order_type='MARKET',
                px=signal['entry_price'],
                qty=signal['position_size'],
                status=status,
                latency_ms=0.0,
                reduce_only=False,
                time_in_force='GTC'
            )
            # Store order_id and decision_id in signal for fill event correlation
            signal['_order_id'] = order_id
            signal['_decision_id'] = decision_id
            logger.info(f"Order event logged successfully: {order_id}")
        except Exception as e:
            logger.error(f"Failed to log order event: {e}", exc_info=True)

