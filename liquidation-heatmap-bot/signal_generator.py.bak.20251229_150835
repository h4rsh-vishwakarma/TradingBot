            else:
                logger.warning(f"No 'price' column found in {timeframe} data. Available: {result.columns.tolist()}")
                return pd.DataFrame()
            
            # Add liquidation_type if not present (default to 'mixed')
            if 'liquidation_type' not in result.columns:
                result['liquidation_type'] = 'mixed'
            
            # Check if required columns exist before dropna
            required_cols = ['price', 'liquidation_leverage']
            missing_cols = [col for col in required_cols if col not in result.columns]
            if missing_cols:
                logger.warning(f"Missing required columns for {timeframe}: {missing_cols}")
