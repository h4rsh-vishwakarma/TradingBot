    def find_nearest_clusters(self, current_price, clusters_df):
        """Find nearest clusters with enhanced logic"""
        if clusters_df.empty:
            return None, None
        
        logger.debug(f"find_nearest_clusters: price={current_price:.2f}, clusters={len(clusters_df)}")
        if len(clusters_df) > 0:
            sample_cluster = clusters_df.iloc[0]
            logger.debug(f"Sample cluster: min_price={sample_cluster.get('min_price')}, max_price={sample_cluster.get('max_price')}, mean_price={sample_cluster.get('mean_price')}")
        
        # Filter clusters based on mean_price relative to current_price
        # This handles overlapping clusters better than using min/max boundaries
        above_clusters = clusters_df[clusters_df['mean_price'] > current_price].copy()
        below_clusters = clusters_df[clusters_df['mean_price'] < current_price].copy()
        
        logger.debug(f"Cluster filtering: above={len(above_clusters)}, below={len(below_clusters)}")
        
        nearest_above, nearest_below = None, None
        
        if not above_clusters.empty:
            above_clusters['distance'] = above_clusters['mean_price'] - current_price
            nearest_above = above_clusters.loc[above_clusters['distance'].idxmin()]
            
        if not below_clusters.empty:
            below_clusters['distance'] = current_price - below_clusters['mean_price']
            nearest_below = below_clusters.loc[below_clusters['distance'].idxmin()]
            
        return nearest_above, nearest_below

    def compute_edge_bps(self, bias: str, current_price: float, target_cluster, multi_tf_score: float = 0.5) -> float:
        """
        Compute expected edge in basis points for a trade.
        
        **FIX #3: Enhanced edge calculation with regime awareness**
        
        Edge is calculated based on:
        1. Distance to target cluster (closer = higher edge potential)
        2. Cluster intensity/density (stronger clusters = higher edge)
        3. Multi-timeframe alignment score
        4. **NEW: Market regime penalty for counter-trend trades**
        
        Formula: edge_bps = intensity_z * max(0, proximity_factor) * tf_multiplier * regime_penalty
        
        Args:
            bias: 'LONG' or 'SHORT'
            current_price: Current market price
            target_cluster: The cluster we're trading towards (nearest_above for SHORT, nearest_below for LONG)
            multi_tf_score: Multi-timeframe alignment score (0-1)
            
        Returns:
            Expected edge in basis points
        """
        if target_cluster is None or current_price is None or current_price <= 0:
            return 0.0
            
        try:
            # Extract cluster metrics
            cluster_price = float(target_cluster.get('mean_price', 0))
            density = float(target_cluster.get('density', 0) or 0)
            intensity = float(target_cluster.get('intensity', density) or density)  # Use density as fallback
            
            if cluster_price <= 0:
                return 0.0
            
            # Calculate distance in bps
            distance_bps = abs(cluster_price - current_price) / current_price * 10000
            
            # Proximity factor: higher edge when closer to cluster (but not too close)
            # Sweet spot is 20-100 bps away; edge decreases beyond 150 bps
            if distance_bps < 10:
                proximity_factor = 0.3  # Too close, might already be priced in
            elif distance_bps <= 50:
                proximity_factor = 1.0  # Optimal zone
            elif distance_bps <= 100:
                proximity_factor = 0.8
            elif distance_bps <= 150:
                proximity_factor = 0.5
            else:
                proximity_factor = max(0.1, 1.0 - (distance_bps - 150) / 200)
            
            # Intensity z-score (normalize to typical range 0-10)
            intensity_z = min(intensity / 100.0, 5.0)  # Cap at 5x
            if intensity_z < 0.1:
                intensity_z = 0.1  # Floor
            
            # Multi-timeframe multiplier (0.5-1.5x based on alignment)
            tf_multiplier = 0.5 + multi_tf_score  # Range: 0.5-1.5
            
            # **NEW: Regime penalty for LONG in declining markets**
            # Reduce edge by 50% if trading against the trend
            regime_penalty = 1.0
            if bias == 'LONG':
                # Check if we have recent price data to detect downtrend
                if hasattr(self, 'ltf_data') and self.ltf_data is not None and not self.ltf_data.empty:
                    if 'close' in self.ltf_data.columns:
                        recent_closes = self.ltf_data['close'].tail(20)
                        if len(recent_closes) >= 10:
                            # Simple downtrend check: SMA5 < SMA20
                            sma5 = recent_closes.tail(5).mean()
                            sma20 = recent_closes.mean()
                            if sma5 < sma20 * 0.995:  # SMA5 is 0.5% below SMA20
                                regime_penalty = 0.5  # Reduce edge by 50%
                                logger.info(f"📉 Regime penalty applied: LONG in downtrend (SMA5=${sma5:.2f} < SMA20=${sma20:.2f}, edge reduced by 50%)")
            
            # Base edge calculation
            base_edge = 5.0  # Minimum expected edge in bps
            
            # Final edge: base + (intensity * proximity * tf_alignment * regime)
            edge_bps = base_edge + (intensity_z * proximity_factor * tf_multiplier * regime_penalty * 10)
            
            # Cap at reasonable maximum (50 bps)
            edge_bps = min(edge_bps, 50.0)
            
            logger.debug(f"Edge calc: bias={bias}, distance_bps={distance_bps:.1f}, "
                        f"intensity_z={intensity_z:.2f}, proximity={proximity_factor:.2f}, "
                        f"tf_mult={tf_multiplier:.2f}, regime_penalty={regime_penalty:.2f}, edge_bps={edge_bps:.2f}")
            
            return round(edge_bps, 2)
            
        except Exception as e:
            logger.error(f"Error computing edge_bps: {e}")
            return 0.0

    def analyze_lsr_trend(self, lsr_data: pd.DataFrame) -> Tuple[str, float]:
        """
        Analyze Long/Short Ratio trend.
        Contrarian Logic:
        - High LSR (> SMA) -> Crowded Longs -> Bearish
        - Low LSR (< SMA) -> Crowded Shorts -> Bullish
        """
        if lsr_data is None or lsr_data.empty:
            return 'NEUTRAL', 0.0
            
        try:
            # Assume column 'Long/Short Ratio' exists, or find first numeric col after timestamp
            cols = [c for c in lsr_data.columns if 'ratio' in c.lower() or 'lsr' in c.lower()]
            col = cols[0] if cols else lsr_data.columns[1] # Fallback to 2nd col
            
            series = pd.to_numeric(lsr_data[col], errors='coerce').dropna()
            if len(series) < 20:
                return 'NEUTRAL', 0.0
                
            current_lsr = series.iloc[-1]
            sma_20 = series.rolling(window=20).mean().iloc[-1]
            
            if current_lsr > sma_20 * 1.05:
                return 'BEARISH', current_lsr # Crowded longs
            elif current_lsr < sma_20 * 0.95:
                return 'BULLISH', current_lsr # Crowded shorts
            else:
                return 'NEUTRAL', current_lsr
        except Exception as e:
            logger.error(f"Error analyzing LSR: {e}")
            return 'NEUTRAL', 0.0

    def calculate_bias(self, nearest_above, nearest_below, current_price, vwap, oi_signal, funding_signal, lsr_signal=None):
        """
        Deterministic voting system for bias calculation.
        
        Implements 3-vote consensus:
        - vote1 (m1_proximity): nearest cluster within 3% of current price
        - vote2 (m2_density): largest density cluster direction
        - vote3 (m3_sentiment): OI delta + funding + LSR combined
        
        Returns: (direction, reason, votes_dict, tie_break_used)
        """
        votes: Dict[str, Optional[str]] = {'m1_proximity': None, 'm2_density': None, 'm3_sentiment': None}
        vote_reasons: Dict[str, str] = {}
        
        # ==================== CLUSTER QUALITY VALIDATION ====================
        # Validate cluster quality before allowing cluster-based votes
        def is_valid_cluster(cluster):
            """Check if cluster has meaningful data (not just garbage values)"""
            # Handle pandas Series (which can't use 'is None' or bool check)
            try:
                if cluster is None or (hasattr(cluster, 'empty') and cluster.empty):
                    return False
                # Require meaningful cluster metrics
                # NOTE: clusters have 'density' (weighted_leverage sum) not 'liquidation_volume_usd'
                strength = float(cluster.get('strength_score', 0) if pd.notna(cluster.get('strength_score')) else 0)
                density = float(cluster.get('density', 0) if pd.notna(cluster.get('density')) else 0)
                data_points = int(cluster.get('data_points', 0) if pd.notna(cluster.get('data_points')) else 0)
                # Cluster must have real strength, density, and minimum data points
                return (density >= self.trading_config.cluster_density_threshold and  # Pass configured density threshold (50000)
                        strength >= 20 and     # Minimum strength score (price_density)
                        data_points >= 2)      # At least 2 liquidation points
            except Exception as e:
                logger.error(f"Cluster validation error: {e}")
                return False
        
        # Log cluster details for debugging
        if nearest_above is not None and not (hasattr(nearest_above, 'empty') and nearest_above.empty):
            above_strength = float(nearest_above.get('strength_score', 0) if pd.notna(nearest_above.get('strength_score')) else 0)
            above_density = float(nearest_above.get('density', 0) if pd.notna(nearest_above.get('density')) else 0)
            above_points = int(nearest_above.get('data_points', 0) if pd.notna(nearest_above.get('data_points')) else 0)
            logger.info(f"Above cluster: strength={above_strength:.0f}, density={above_density:.0f}, points={above_points}, threshold={self.trading_config.cluster_density_threshold}")
        if nearest_below is not None and not (hasattr(nearest_below, 'empty') and nearest_below.empty):
            below_strength = float(nearest_below.get('strength_score', 0) if pd.notna(nearest_below.get('strength_score')) else 0)
            below_density = float(nearest_below.get('density', 0) if pd.notna(nearest_below.get('density')) else 0)
            below_points = int(nearest_below.get('data_points', 0) if pd.notna(nearest_below.get('data_points')) else 0)
            logger.info(f"Below cluster: strength={below_strength:.0f}, density={below_density:.0f}, points={below_points}, threshold={self.trading_config.cluster_density_threshold}")
        
        above_valid = is_valid_cluster(nearest_above)
        below_valid = is_valid_cluster(nearest_below)
        
        logger.info(f"Cluster validation: above_valid={above_valid}, below_valid={below_valid}")
        
        # ==================== VOTE 1: m1_proximity ====================
        # Nearest cluster within 5% determines direction (ONLY if cluster is valid)
        proximity_threshold = 0.05  # 5% (widened from 3% for more opportunities)
        
        above_dist = None
        below_dist = None
        
        if nearest_above is not None and above_valid:
            above_price = float(nearest_above.get('mean_price', 0))
            if above_price > 0:
                above_dist = (above_price - current_price) / current_price
        
        if nearest_below is not None and below_valid:
            below_price = float(nearest_below.get('mean_price', 0))
            if below_price > 0:
                below_dist = (current_price - below_price) / current_price
        
        # Vote based on nearest VALID cluster within threshold
        logger.debug(f"Proximity voting: above_dist={above_dist}, below_dist={below_dist}, threshold={proximity_threshold}")
        
        if above_dist is not None and below_dist is not None:
            if above_dist <= proximity_threshold and below_dist <= proximity_threshold:
                # Both within range - pick nearest
                if above_dist < below_dist:
                    votes['m1_proximity'] = 'SHORT'  # Cluster above = shorts getting liquidated = bearish
                    vote_reasons['m1'] = f'Above cluster nearer ({above_dist:.2%} vs {below_dist:.2%})'
                else:
                    votes['m1_proximity'] = 'LONG'  # Cluster below = longs getting liquidated = bullish
                    vote_reasons['m1'] = f'Below cluster nearer ({below_dist:.2%} vs {above_dist:.2%})'
            elif above_dist <= proximity_threshold:
                votes['m1_proximity'] = 'SHORT'
                vote_reasons['m1'] = f'Above cluster within range ({above_dist:.2%})'
            elif below_dist <= proximity_threshold:
                votes['m1_proximity'] = 'LONG'
                vote_reasons['m1'] = f'Below cluster within range ({below_dist:.2%})'
            else:
                vote_reasons['m1'] = f'No cluster within 3% (above={above_dist:.2%}, below={below_dist:.2%})'
        elif above_dist is not None and above_dist <= proximity_threshold:
            votes['m1_proximity'] = 'SHORT'
            vote_reasons['m1'] = f'Only above cluster within range ({above_dist:.2%})'
        elif below_dist is not None and below_dist <= proximity_threshold:
            votes['m1_proximity'] = 'LONG'
            vote_reasons['m1'] = f'Only below cluster within range ({below_dist:.2%})'
        else:
            vote_reasons['m1'] = 'No valid clusters within 5%'
        
        # ==================== VOTE 2: m2_density ====================
        # Largest density cluster determines direction (ONLY if clusters are valid)
        above_density = float(nearest_above.get('density', 0) or 0) if (nearest_above is not None and above_valid) else 0
        below_density = float(nearest_below.get('density', 0) or 0) if (nearest_below is not None and below_valid) else 0
        
        logger.debug(f"Density voting: above={above_density}, below={below_density}, above_valid={above_valid}, below_valid={below_valid}")
        
        if above_density > 0 or below_density > 0:
            if above_density > below_density:
                votes['m2_density'] = 'SHORT'  # Larger cluster above = more shorts to liquidate
                vote_reasons['m2'] = f'Above density higher ({above_density:.0f} vs {below_density:.0f})'
            elif below_density > above_density:
                votes['m2_density'] = 'LONG'  # Larger cluster below = more longs to liquidate
                vote_reasons['m2'] = f'Below density higher ({below_density:.0f} vs {above_density:.0f})'
            else:
                vote_reasons['m2'] = f'Equal density ({above_density:.0f})'
        else:
            vote_reasons['m2'] = 'No density data'
        
        # ==================== VOTE 3: m3_sentiment ====================
        # Combined sentiment from OI, Funding, and LSR
        sentiment_score = 0  # Positive = bullish, Negative = bearish
        sentiment_factors = []
        
        # OI signal (weight: 2)
        if isinstance(oi_signal, (list, tuple)) and len(oi_signal) >= 1:
            if oi_signal[0] == 'BULLISH':
                sentiment_score += 2
                sentiment_factors.append(f'OI_BULL(+2)')
            elif oi_signal[0] == 'BEARISH':
                sentiment_score -= 2
                sentiment_factors.append(f'OI_BEAR(-2)')
        
        # Funding signal (weight: 2)
        if isinstance(funding_signal, (list, tuple)) and len(funding_signal) >= 1:
            if funding_signal[0] == 'BULLISH':
                sentiment_score += 2
                sentiment_factors.append(f'FR_BULL(+2)')
            elif funding_signal[0] == 'BEARISH':
                sentiment_score -= 2
                sentiment_factors.append(f'FR_BEAR(-2)')
        
        # LSR signal (weight: 2) - Replaces VWAP proxy
        if lsr_signal:
            if lsr_signal[0] == 'BULLISH':
                sentiment_score += 2
                sentiment_factors.append(f'LSR_BULL(+2)')
            elif lsr_signal[0] == 'BEARISH':
                sentiment_score -= 2
                sentiment_factors.append(f'LSR_BEAR(-2)')
        
        # VWAP context (weight: 1) - Downgraded to secondary factor
        if vwap is not None and vwap > 0:
            premium = (current_price - vwap) / vwap
            if premium > 0.002:  # 0.2% above VWAP
                sentiment_score += 1
                sentiment_factors.append(f'VWAP+(+1)')
            elif premium < -0.002:  # 0.2% below VWAP
                sentiment_score -= 1
                sentiment_factors.append(f'VWAP-(-1)')
        
        if sentiment_score > 0:
            votes['m3_sentiment'] = 'LONG'
            vote_reasons['m3'] = f'Bullish sentiment ({sentiment_score}): {",".join(sentiment_factors)}'
        elif sentiment_score < 0:
            votes['m3_sentiment'] = 'SHORT'
            vote_reasons['m3'] = f'Bearish sentiment ({sentiment_score}): {",".join(sentiment_factors)}'
        else:
            votes['m3_sentiment'] = 'NEUTRAL'  # Cast neutral vote instead of leaving None
            vote_reasons['m3'] = f'Neutral sentiment: {",".join(sentiment_factors) or "no factors"}'
        
        # ==================== VOTE COUNTING ====================
        long_votes = sum(1 for v in votes.values() if v == 'LONG')
        short_votes = sum(1 for v in votes.values() if v == 'SHORT')
        
        logger.info(f'Voting results: LONG={long_votes} SHORT={short_votes} | m1={votes["m1_proximity"]} m2={votes["m2_density"]} m3={votes["m3_sentiment"]}')
        
        # ==================== WEAK SIGNAL REJECTION ====================
        # Reject trades when only cluster-based votes decide (m1/m2) and sentiment is NEUTRAL
        # EXCEPTION: Allow if BOTH cluster votes agree (strong cluster consensus)
        if votes['m3_sentiment'] == 'NEUTRAL':
            cluster_vote_count = sum(1 for k in ['m1_proximity', 'm2_density'] if votes[k] in ['LONG', 'SHORT'])
            cluster_agreement = (votes.get('m1_proximity') == votes.get('m2_density') and 
                                 votes.get('m1_proximity') in ['LONG', 'SHORT'])
            
            if cluster_vote_count == long_votes + short_votes:
                # All votes from clusters, no sentiment
                if cluster_agreement and cluster_vote_count >= 2:
                    # ALLOW: Both cluster votes agree on direction (strong signal)
                    logger.info(f"Allowing cluster consensus: m1={votes['m1_proximity']} m2={votes['m2_density']} (no sentiment but strong agreement)")
                else:
                    # REJECT: Cluster votes weak or conflicting
                    logger.warning("Rejecting weak signal: Only cluster votes with NEUTRAL sentiment (no OI/funding/LSR confirmation)")
                    direction = None
                    bias_reason = "Rejected: cluster-only votes without sentiment confirmation"
                    return direction, bias_reason, votes, False
        
        tie_break_used = False
        direction = None
        
        if long_votes > short_votes:
            direction = 'LONG'
            bias_reason = f"LONG wins {long_votes}-{short_votes}: {vote_reasons.get('m1','')} | {vote_reasons.get('m2','')} | {vote_reasons.get('m3','')}"
        elif short_votes > long_votes:
            direction = 'SHORT'
            bias_reason = f"SHORT wins {short_votes}-{long_votes}: {vote_reasons.get('m1','')} | {vote_reasons.get('m2','')} | {vote_reasons.get('m3','')}"
        else:
            # TIE or all None - need tie-breaker
            # If all votes are None, use density as fallback
            if long_votes == 0 and short_votes == 0:
                above_density = float(nearest_above.get('density', 0) or 0) if nearest_above is not None else 0
                below_density = float(nearest_below.get('density', 0) or 0) if nearest_below is not None else 0
                if below_density > above_density * 1.1:  # 10% edge
                    direction = 'LONG'
                    bias_reason = f"Density fallback: LONG (below={below_density:.0f} vs above={above_density:.0f})"
                    tie_break_used = True
                elif above_density > below_density * 1.1:
                    direction = 'SHORT'
                    bias_reason = f"Density fallback: SHORT (above={above_density:.0f} vs below={below_density:.0f})"
                    tie_break_used = True
                else:
                    # Use higher TF tie-breaker
                    tie_break_used = True
                    direction, bias_reason = self._apply_tie_breaker(nearest_above, nearest_below, votes, vote_reasons)
            else:
                # Regular tie - use higher timeframe (3d/1w data)
                tie_break_used = True
                direction, bias_reason = self._apply_tie_breaker(nearest_above, nearest_below, votes, vote_reasons)
        
        logger.info(f'Bias calc result: direction={direction} tie_break={tie_break_used}')
        
        # Store votes for logging
        self._last_votes = votes
        self._last_tie_break_used = tie_break_used
        
        return direction, bias_reason, votes, tie_break_used
    
    def _apply_tie_breaker(self, nearest_above, nearest_below, votes, vote_reasons):
        """
        P1 IMPROVEMENT: 3d/1w Tie-Break Logic
        When 12h/24h/48h votes conflict, use higher timeframe (3d/1w) bias.
        """
        logger.info("Applying tie-breaker logic for vote tie")
        
        # Try to use 3d and 1w data for tie-break (P1 requirement)
        try:
            # Check if we have processed 3d/1w timeframe data
            higher_tf_signals = {}
            
            for tf in ['3d', '1week']:
                tf_data = self.timeframe_data.get(tf) if hasattr(self, 'timeframe_data') else None
                if tf_data is not None and not tf_data.empty:
                    # Analyze this higher timeframe's cluster positioning
                    tf_clusters = self.identify_clusters(tf_data)
                    if not tf_clusters.empty:
                        # Find nearest clusters relative to current price
                        above = tf_clusters[tf_clusters['mean_price'] > self.current_price]
                        below = tf_clusters[tf_clusters['mean_price'] < self.current_price]
                        
                        above_density = above['density'].sum() if not above.empty else 0
                        below_density = below['density'].sum() if not below.empty else 0
                        
                        if below_density > above_density * 1.15:  # 15% threshold for higher TF
                            higher_tf_signals[tf] = ('LONG', below_density - above_density)
                        elif above_density > below_density * 1.15:
                            higher_tf_signals[tf] = ('SHORT', above_density - below_density)
            
            # Prioritize 3d, then 1w for tie-break decision
            if '3d' in higher_tf_signals:
                direction, strength = higher_tf_signals['3d']
                logger.info(f"Tie-break using 3d data: {direction} (strength={strength:.0f})")
                return direction, f"Tie-break: 3d timeframe bias {direction}"
            elif '1week' in higher_tf_signals:
                direction, strength = higher_tf_signals['1week']
                logger.info(f"Tie-break using 1w data: {direction} (strength={strength:.0f})")
                return direction, f"Tie-break: 1w timeframe bias {direction}"
                
        except Exception as e:
            logger.warning(f"Higher TF tie-breaker error: {e}")
        
        # Fallback: use current cluster density if no 3d/1w data
        logger.info("No 3d/1w data available, using current cluster density for tie-break")
        above_density = float(nearest_above.get('density', 0) or 0) if nearest_above else 0
        below_density = float(nearest_below.get('density', 0) or 0) if nearest_below else 0
        
        if above_density > below_density * 1.1:  # 10% threshold
            return 'SHORT', f"Tie-break density: above {above_density:.0f} > below {below_density:.0f}"
        elif below_density > above_density * 1.1:
            return 'LONG', f"Tie-break density: below {below_density:.0f} > above {above_density:.0f}"
        
        # Final fallback: no trade on perfect tie
        return None, f"Perfect tie - no clear direction (votes={votes})"

    def aggregate_multitimeframe_signals(self, timeframe_signals: Dict[str, Tuple[str, float]]) -> Tuple[Optional[str], float, str]:
        """
        P1 IMPROVEMENT: Multi-Timeframe Signal Aggregator
        
        Aggregates signals from multiple timeframes using weighted voting to create
        a coherent consensus signal. Handles conflicts intelligently.
        
        Args:
            timeframe_signals: Dict of {timeframe: (direction, confidence)} 
                               e.g., {'12h': ('LONG', 0.85), '24h': ('SHORT', 0.72)}
        
        Returns:
            (final_direction, final_confidence, explanation)
        """
        if not timeframe_signals:
            return None, 0.0, "No timeframe signals available"
        
        # Timeframe weights (shorter = more responsive, longer = more stable)
        tf_weights = {'12h': 0.35, '24h': 0.25, '48h': 0.20, '3d': 0.12, '1week': 0.08}
        
        long_score = 0.0
        short_score = 0.0
        neutral_weight = 0.0
        
        signal_breakdown = []
        
        for tf, (direction, confidence) in timeframe_signals.items():
            weight = tf_weights.get(tf, 0.10)  # Default weight for unknown timeframes
            weighted_conf = confidence * weight
            
            if direction == 'LONG':
                long_score += weighted_conf
                signal_breakdown.append(f"{tf}:LONG({confidence:.2f})")
            elif direction == 'SHORT':
                short_score += weighted_conf
                signal_breakdown.append(f"{tf}:SHORT({confidence:.2f})")
            else:  # NEUTRAL or None
                neutral_weight += weight
                signal_breakdown.append(f"{tf}:NEUTRAL")
        
        # Normalize scores by total weight used
        total_weight = sum(tf_weights.get(tf, 0.10) for tf in timeframe_signals.keys())
        if total_weight > 0:
            long_score /= total_weight
            short_score /= total_weight
        
        # Determine final direction with conflict threshold
        min_edge = 0.05  # Require 5% edge for directional signal (lowered for more opportunities)
        
        if long_score > short_score + min_edge:
            final_direction = 'LONG'
            final_confidence = long_score
            explanation = f"Multi-TF consensus LONG (score={long_score:.2f} vs SHORT={short_score:.2f}): {' | '.join(signal_breakdown)}"
        elif short_score > long_score + min_edge:
            final_direction = 'SHORT'
            final_confidence = short_score
            explanation = f"Multi-TF consensus SHORT (score={short_score:.2f} vs LONG={long_score:.2f}): {' | '.join(signal_breakdown)}"
        else:
            # Conflicting signals - no trade
            final_direction = None
            final_confidence = max(long_score, short_score)
            explanation = f"Multi-TF conflict (LONG={long_score:.2f} SHORT={short_score:.2f}): {' | '.join(signal_breakdown)}"
        
        logger.info(f"Multi-TF Aggregation: {explanation}")
        return final_direction, final_confidence, explanation

