            # Drop rows with NaN in critical columns
            before_drop = len(result)
            result = result.dropna(subset=['price', 'liquidation_leverage'])
            after_drop = len(result)
            if before_drop != after_drop:
                logger.info(f"Dropped {before_drop - after_drop} rows with NaN values for {timeframe}")
            
            # Add timeframe column for tracking
            result['timeframe'] = timeframe
            
            logger.info(f"Preprocessed {len(result)} rows for {timeframe}")
            return result
            
        except Exception as e:
