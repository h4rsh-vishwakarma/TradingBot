    def trigger_kill_switch(self, reason: str):
        """Activate kill switch to stop all trading."""
        if not self.kill_switch_active:
            self.kill_switch_active = True
            self.kill_switch_reason = reason
            self.kill_switch_trigger_time = time.time()
            logger.critical(f"💀 KILL SWITCH ACTIVATED: {reason}")
            # Close all positions if possible (paper/live)
            # In paper mode, we might just log it. In live, we'd send close orders.
            if self.emitters:
                try: self.emitters.emit('kill_switch_activated', {'reason': reason})
                except Exception: pass
            
            # Allow auto-reset if configured (e.g. via file flag)
            if os.getenv('ALLOW_KILL_RESET_FILE','0') == '1':
                logger.info("Kill switch active. To reset, create 'reset_kill_switch' file.")
    
    def check_kill_switch_auto_reset(self):
        """Check if kill switch should auto-reset after cooldown period."""
        if not self.kill_switch_active or not self.kill_switch_trigger_time:
            return
        
        hours_since_trigger = (time.time() - self.kill_switch_trigger_time) / 3600
        
        # Auto-reset after configured hours if system health has improved
        if hours_since_trigger >= self.kill_switch_auto_reset_hours:
            # Check if consecutive rejection streaks have cleared
            if self.risk_rejection_streak < 5:  # Health improved
                logger.info(f"✅ Kill switch auto-reset after {hours_since_trigger:.1f}h cooldown. System health improved.")
                self.kill_switch_active = False
                self.kill_switch_reason = None
                self.kill_switch_trigger_time = None
                self.risk_rejection_streak = 0
                if self.emitters:
                    try: self.emitters.emit('kill_switch_reset', {'reason': 'auto_reset_after_cooldown'})
                    except Exception: pass
            else:
                logger.warning(f"Kill switch cooldown period passed ({hours_since_trigger:.1f}h) but system health not improved (streak: {self.risk_rejection_streak})")


    def _on_quota_error(self, error_msg: str):
        """Callback for sheets quota errors."""
        self.sheets_quota_errors += 1
        if metrics.PROM_AVAILABLE:
            try: metrics.sheets_error_counter.inc()
            except Exception: pass
        
        if self.sheets_quota_errors >= self.sheets_quota_threshold:
            self.trigger_kill_switch(f"sheets_quota_exceeded_{self.sheets_quota_errors}")

