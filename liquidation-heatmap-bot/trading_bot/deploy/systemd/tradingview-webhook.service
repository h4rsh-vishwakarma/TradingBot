[Unit]
Description=TradingView Webhook Server (Gunicorn)
After=network.target

[Service]
Type=notify
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/tradingview-webhook-mvp/trading_bot
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/home/ubuntu/tradingview-webhook-mvp/trading_bot/.env

# Gunicorn with Unix socket binding (secure, faster than TCP)
ExecStart=/usr/bin/python3 -m gunicorn \
    --bind unix:/run/tradingview_webhook.sock \
    --workers 4 \
    --worker-class sync \
    --timeout 30 \
    --access-logfile /home/ubuntu/logs/webhook_access.log \
    --error-logfile /home/ubuntu/logs/webhook_error.log \
    --log-level info \
    --capture-output \
    trading_bot.wsgi:app

# Runtime directory for socket
RuntimeDirectory=tradingview_webhook
RuntimeDirectoryMode=0755

# Socket permissions
ExecStartPost=/bin/chmod 666 /run/tradingview_webhook.sock

# Restart policy (CRITICAL for production reliability)
Restart=always
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
