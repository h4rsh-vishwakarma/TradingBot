# --- 1. CORE SERVER CONFIG ---
# Secret key to validate incoming TradingView webhooks
WEBHOOK_SECRET="your_secure_webhook_secret_here"
PORT=5000
# Options: production, development
RUN_MODE="production"

# --- 2. MODULAR PATHS ---
# Absolute paths to your storage and log files
QUEUE_PATH="/home/ubuntu/tradingview_webhook_bot/storage/signals.jsonl"
OFFSET_PATH="/home/ubuntu/tradingview_webhook_bot/storage/signals.offset"
LEDGER_PATH="/home/ubuntu/tradingview_webhook_bot/storage/ledger_state.json"
ALERTS_LOG="/home/ubuntu/tradingview_webhook_bot/storage/alerts.jsonl"
IDEMPOTENCY_DB_PATH="/home/ubuntu/tradingview_webhook_bot/storage/idempotency.db"
LOG_FILE="/home/ubuntu/tradingview_webhook_bot/logs/bot.log"

# --- 3. TELEGRAM CHANNELS ---
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_CHAT_ID="your_main_chat_id"
TELEGRAM_CHAT_ID_SYSTEM="your_system_alerts_chat_id"
TELEGRAM_CHAT_ID_TRADES="your_trade_logs_chat_id"

# --- 4. GOOGLE SHEETS ---
GOOGLE_SERVICE_ACCOUNT_FILE="/etc/tradingbot/service_account.json"
GOOGLE_SHEET_NAME="Trading_Bot_Ledger"

# --- 5. EMAIL NOTIFICATIONS ---
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
EMAIL_SENDER="your_email@gmail.com"
# Use an App Password if using Gmail
EMAIL_PASSWORD="your_app_password_here"
EMAIL_RECEIVER="receiver_email@gmail.com"

# --- 6. BINANCE FUTURES CONFIG ---
BINANCE_API_KEY="your_binance_api_key"
BINANCE_API_SECRET="your_binance_api_secret"
BINANCE_TESTNET="True"
ALLOW_REAL_TRADES="False"
ALLOWED_SYMBOLS="BTCUSDT,ETHUSDT,SOLUSDT"

# --- 7. SYSTEM LIMITS ---
# Dead Letter Queue settings
DLQ_THRESHOLD=5
DLQ_WINDOW_SECONDS=60

# --- 8. P&L ENV ---
MAX_NOTIONAL_PER_TRADE="500.0"
DAILY_LOSS_LIMIT="-50.0"

# --- 9. HYPER LIQUID CONFIG ---
HL_WALLET_ADDRESS="0xYourWalletAddress"
HL_PRIVATE_KEY="0xYourPrivateKey"
HL_IS_TESTNET="True"
TRADER_ADDRESSES="0xTraderAddressToFollow"
POLL_INTERVAL_SECONDS="5"
