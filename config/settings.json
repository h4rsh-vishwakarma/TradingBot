{
  "strategy_name": "multi_strategy",
  "virtual_balance": 1000.0,
  "logging": {
    "file": "logs/enhanced_bot.log",
    "level": "INFO"
  },
  "strategies": {
    "enabled": [
      "multi_strategy"
    ],
    "signal_expiry_seconds": 300,
    "allow_opposite_signals": false,
    "max_concurrent_strategies_per_symbol": 1
  },
  "trading": {
    "symbols_allowed": [
      "SUIUSDT",
      "INJUSDT",
      "LDOUSDT",
      "NEARUSDT",
      "APTUSDT"
    ],
    "timeframes_allowed": [
      "1",
      "5",
      "15",
      "60",
      "240",
      "D"
    ],
    "leverage": 2,
    "order_type": "LIMIT"
  },
  "risk": {
    "max_positions": 5,
    "position_size_type": "PERCENT_OF_BALANCE",
    "position_size_value": 20.0,
    "min_position_usd": 10.0,
    "max_symbol_exposure": 50.0,
    "risk_per_trade_percent": 1.0,
    "stop_loss_pct": 1.0,
    "take_profit_pct": 3.0,
    "max_drawdown_limit": 10.0,
    "slippage_allowed_pct": 0.1
  },
  "webhook": {
    "host": "0.0.0.0",
    "port": 5000,
    "secret": "${WEBHOOK_SECRET}"
  },
  "storage": {
    "signals_queue": "storage/signals_multi_strategy.jsonl",
    "positions": "storage/positions_multi_strategy.jsonl",
    "balance": "storage/balance_multi_strategy.json"
  },
  "telegram": {
    "token": "${TELEGRAM_BOT_TOKEN}",
    "chat_id": "${TELEGRAM_CHAT_ID}"
  }
}