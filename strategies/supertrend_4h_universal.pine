//  UNIVERSAL SCRIPT  works on all 16 symbols automatically
// Supported symbols: FILUSDT, LDOUSDT, OPUSDT, UNIUSDT, SOLUSDT, DOTUSDT,
//                    LINKUSDT, AVAXUSDT, NEARUSDT, INJUSDT, SUIUSDT, ARBUSDT,
//                    AAVEUSDT, DOGEUSDT, APTUSDT, ATOMUSDT
//
// Auto-detects symbol and applies optimized parameters  no manual changes needed.
// Strategy: SuperTrend (ATR-based direction flip)  4H Universal v3
// Proven leaderboard performance: PF=1.271.32

//@version=5
strategy(
     title       = "SuperTrend [Universal] v3  4H ALL SYMBOLS",
     shorttitle  = "ST-4H-UNIVERSAL",
     overlay     = true,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 10,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.06,
     initial_capital   = 10000
 )

// 
// 1. AUTO SYMBOL DETECTION
// 
sym    = syminfo.ticker
isFIL  = str.contains(sym, "FIL")
isLDO  = str.contains(sym, "LDO")
isOP   = str.contains(sym, "OP") and not str.contains(sym, "OPT")
isUNI  = str.contains(sym, "UNI")
isSOL  = str.contains(sym, "SOL")
isDOT  = str.contains(sym, "DOT")
isLINK = str.contains(sym, "LINK")
isAVAX = str.contains(sym, "AVAX")
isNEAR = str.contains(sym, "NEAR")
isINJ  = str.contains(sym, "INJ")
isSUI  = str.contains(sym, "SUI")
isARB  = str.contains(sym, "ARB")
isAAVE = str.contains(sym, "AAVE")
isDOGE = str.contains(sym, "DOGE")
isAPT  = str.contains(sym, "APT")
isATOM = str.contains(sym, "ATOM")

// ATR period  per-symbol optimized
auto_atr_period = isFIL  ? 10 : isLDO  ? 10 : isOP   ? 10 : isUNI  ? 10 :
                  isSOL  ? 10 : isDOT  ? 12 : isLINK ? 10 : isAVAX ? 10 :
                  isNEAR ? 10 : isINJ  ? 10 : isSUI  ? 10 : isARB  ? 10 :
                  isAAVE ? 12 : isDOGE ? 10 : isAPT  ? 10 : isATOM ? 10 : 10

// ATR factor  per-symbol optimized
auto_factor = isFIL  ? 2.57 : isLDO  ? 3.07 : isOP   ? 2.77 : isUNI  ? 2.20 :
              isSOL  ? 3.00 : isDOT  ? 2.80 : isLINK ? 2.60 : isAVAX ? 2.90 :
              isNEAR ? 2.50 : isINJ  ? 2.40 : isSUI  ? 2.60 : isARB  ? 2.50 :
              isAAVE ? 2.80 : isDOGE ? 2.30 : isAPT  ? 2.60 : isATOM ? 2.70 : 3.00

// 
// 2. INPUTS
// 
grp_ovr = "Manual Override"
manual_override = input.bool(false, "Enable Manual Override",  group = grp_ovr)
man_atr_period  = input.int(10,     "Manual ATR Period",       group = grp_ovr, minval = 1)
man_factor      = input.float(3.0,  "Manual Factor",           group = grp_ovr, minval = 0.1, step = 0.01)

grp_risk = "Risk Management"
sl_pct  = input.float(2.0, "Stop Loss %",   group = grp_risk, minval = 0.1, step = 0.1)
tp_pct  = input.float(6.0, "Take Profit %", group = grp_risk, minval = 0.1, step = 0.1)

grp_flt = "Filters"
adx_threshold  = input.int(20, "ADX Threshold",           group = grp_flt, minval = 1)
min_bars_gap   = input.int(2,  "Min Bars Between Signals", group = grp_flt, minval = 1)
cooldown_count = input.int(3,  "Losses Before Cooldown",  group = grp_flt, minval = 1)

// 
// 3. RESOLVED PARAMS
// 
atr_period = manual_override ? man_atr_period : auto_atr_period
st_factor  = manual_override ? man_factor     : auto_factor

// 
// 4. SUPERTREND
// 
[st_line, direction] = ta.supertrend(st_factor, atr_period)

// Direction: -1 = bullish (price above ST), +1 = bearish (price below ST)
// ta.change() returns series float  must compare != 0, not use as bool directly
flip_to_long  = ta.change(direction) != 0 and direction == -1   // flipped bullish
flip_to_short = ta.change(direction) != 0 and direction ==  1   // flipped bearish

// 
// 5. ADX FILTER
// 
adx_len  = 14
[diplus, diminus, adx_val] = ta.dmi(adx_len, adx_len)
adx_ok   = adx_val > adx_threshold

// 
// 6. BAR GAP FILTER
// 
var int last_sig_bar = na
bars_since_sig = na(last_sig_bar) ? min_bars_gap + 1 : bar_index - last_sig_bar
gap_ok = bars_since_sig >= min_bars_gap

// 
// 7. LOSS COOLDOWN
// 
var int  consec_losses  = 0
var bool in_cooldown    = false
var int  cooldown_start = na

if strategy.closedtrades > 0
    last_pl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if last_pl < 0
        consec_losses += 1
    else
        consec_losses := 0

if consec_losses >= cooldown_count
    in_cooldown    := true
    cooldown_start := bar_index
    consec_losses  := 0

if in_cooldown and (bar_index - cooldown_start) >= 3
    in_cooldown := false

// 
// 8. ENTRY / EXIT CONDITIONS
// 
long_cond  = flip_to_long  and adx_ok and gap_ok and not in_cooldown
short_cond = flip_to_short and adx_ok and gap_ok and not in_cooldown

if long_cond
    strategy.entry("Long", strategy.long)
    last_sig_bar := bar_index

if short_cond
    strategy.entry("Short", strategy.short)
    last_sig_bar := bar_index

// SL / TP
if strategy.position_size > 0
    entry_p = strategy.position_avg_price
    strategy.exit("Long Exit", "Long",
         stop   = entry_p * (1 - sl_pct / 100),
         limit  = entry_p * (1 + tp_pct / 100))

if strategy.position_size < 0
    entry_p = strategy.position_avg_price
    strategy.exit("Short Exit", "Short",
         stop   = entry_p * (1 + sl_pct / 100),
         limit  = entry_p * (1 - tp_pct / 100))

// 
// 9. ALERTS
// 
if long_cond
    alert('{"symbol":"' + sym + '","action":"buy","strategy":"SuperTrend","timeframe":"4h","price":"' + str.tostring(close) + '","sl_pct":' + str.tostring(sl_pct) + ',"tp_pct":' + str.tostring(tp_pct) + '}', alert.freq_once_per_bar_close)

if short_cond
    alert('{"symbol":"' + sym + '","action":"sell","strategy":"SuperTrend","timeframe":"4h","price":"' + str.tostring(close) + '","sl_pct":' + str.tostring(sl_pct) + ',"tp_pct":' + str.tostring(tp_pct) + '}', alert.freq_once_per_bar_close)

// 
// 10. PLOT SUPERTREND LINE
// 
st_color = direction == -1 ? color.new(color.lime, 0) : color.new(color.red, 0)
plot(st_line, "SuperTrend", color = st_color, linewidth = 2)

// Entry markers
plotshape(long_cond,  "Long Signal",  style = shape.triangleup,
          location = location.belowbar, color = color.lime, size = size.small)
plotshape(short_cond, "Short Signal", style = shape.triangledown,
          location = location.abovebar, color = color.red,  size = size.small)

// 
// 11. DASHBOARD TABLE
// 
var table dash = table.new(position.top_right, 2, 8,
     bgcolor      = color.new(color.black, 75),
     border_width = 1,
     border_color = color.gray,
     frame_width  = 1,
     frame_color  = color.gray)

tbl_label(row, txt) =>
    table.cell(dash, 0, row, txt,
         text_color = color.silver, text_size = size.small,
         bgcolor    = color.new(color.black, 85))

tbl_value(row, txt, clr) =>
    table.cell(dash, 1, row, txt,
         text_color = clr, text_size = size.small,
         bgcolor    = color.new(color.black, 75))

pos_str  = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
pos_clr  = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray
ovr_str  = manual_override ? "MANUAL" : "AUTO"
dir_str  = direction == -1 ? "BULLISH" : "BEARISH"
dir_clr  = direction == -1 ? color.lime : color.red

if barstate.islast
    tbl_label(0, "ST-4H UNIVERSAL")
    tbl_value(0, ovr_str, manual_override ? color.yellow : color.aqua)

    tbl_label(1, "Symbol")
    tbl_value(1, sym, color.white)

    tbl_label(2, "ATR Period")
    tbl_value(2, str.tostring(atr_period), color.aqua)

    tbl_label(3, "Factor")
    tbl_value(3, str.tostring(st_factor, "#.##"), color.aqua)

    tbl_label(4, "ST Direction")
    tbl_value(4, dir_str, dir_clr)

    tbl_label(5, "Position")
    tbl_value(5, pos_str, pos_clr)

    tbl_label(6, "ADX")
    tbl_value(6, str.tostring(math.round(adx_val, 1)), adx_val > adx_threshold ? color.lime : color.red)

    tbl_label(7, "Cooldown")
    tbl_value(7, in_cooldown ? "YES" : "NO", in_cooldown ? color.red : color.lime)
