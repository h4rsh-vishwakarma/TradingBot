// v1 2026-05-02
//@version=5
strategy("G88 Vortex + Donchian — 4H Webhook [BOT]",
     overlay=true,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10,
     initial_capital=10000,
     commission_type=strategy.commission.percent,
     commission_value=0.05)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
vortex_len = input.int(14,   "Vortex Period")
don_len    = input.int(20,   "Donchian Period")
ema_len    = input.int(50,   "EMA Trend Filter")
adx_len    = input.int(14,   "ADX Period")
adx_min    = input.int(20,   "ADX Minimum")
rsi_len    = input.int(14,   "RSI Period")
sl_pct     = input.float(1.5, "Stop Loss %",   step=0.1) / 100
tp_pct     = input.float(12.0,"Take Profit %", step=0.5) / 100
symbol_id  = input.string("XRPUSDT", "Symbol for alert payload")

// ─── VORTEX INDICATOR ─────────────────────────────────────────────────────────
tr_v     = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
vm_plus  = math.abs(high - low[1])
vm_minus = math.abs(low  - high[1])
vi_plus  = math.sum(vm_plus,  vortex_len) / math.max(math.sum(tr_v, vortex_len), 0.0001)
vi_minus = math.sum(vm_minus, vortex_len) / math.max(math.sum(tr_v, vortex_len), 0.0001)

// ─── DONCHIAN CHANNEL ─────────────────────────────────────────────────────────
don_high = ta.highest(high, don_len)
don_low  = ta.lowest(low,   don_len)

// ─── FILTERS ──────────────────────────────────────────────────────────────────
ema50    = ta.ema(close, ema_len)
rsi      = ta.rsi(close, rsi_len)
[_, _, adx_val] = ta.dmi(adx_len, adx_len)

// ─── SIGNALS ──────────────────────────────────────────────────────────────────
// VI+ crossover within last 3 bars (matching Python OOS logic)
vcu = ta.crossover(vi_plus, vi_minus)
vru = vcu or vcu[1] or vcu[2]
vcd = ta.crossunder(vi_plus, vi_minus)
vrd = vcd or vcd[1] or vcd[2]

long_cond  = vru and close > don_high[1] and close > ema50 and adx_val > adx_min and rsi < 72
exit_cond  = vi_plus < vi_minus

// ─── STRATEGY ─────────────────────────────────────────────────────────────────
if long_cond and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    strategy.exit("Long_Exit", "Long",
         loss   = strategy.position_avg_price * sl_pct / syminfo.mintick,
         profit = strategy.position_avg_price * tp_pct / syminfo.mintick)

if exit_cond and strategy.position_size > 0
    strategy.close("Long")

// ─── VISUALS ──────────────────────────────────────────────────────────────────
plot(don_high, "Don High", color.new(color.blue,  60))
plot(don_low,  "Don Low",  color.new(color.blue,  60))
plot(ema50,    "EMA50",    color.new(color.orange, 40))
plotshape(long_cond, "LONG", shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(exit_cond and strategy.position_size > 0, "EXIT", shape.triangledown, location.abovebar, color.red, size=size.small)

// ─── ALERTS ───────────────────────────────────────────────────────────────────
alertcondition(long_cond, "G88 LONG 4H", '{"symbol":"{{ticker}}","action":"buy","strategy":"G88_Vortex_Donchian","timeframe":"4h","price":"{{close}}","sl_pct":1.5,"tp_pct":12.0,"secret":"squeeze_tradingview_cluster_2026_secure"}')
alertcondition(exit_cond, "G88 EXIT 4H", '{"symbol":"{{ticker}}","action":"sell","strategy":"G88_Vortex_Donchian","timeframe":"4h","price":"{{close}}","sl_pct":1.5,"tp_pct":12.0,"secret":"squeeze_tradingview_cluster_2026_secure"}')
