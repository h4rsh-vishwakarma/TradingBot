// v3 2026-05-02  P-02: fixed $500 notional + 0.15% commission; P-03: secret placeholder
//@version=5
strategy("G111 Supertrend + Donchian — 4H Webhook [BOT]",
     overlay=true,
     default_qty_type=strategy.cash,
     default_qty_value=500,
     initial_capital=10000,
     commission_type=strategy.commission.percent,
     commission_value=0.15)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
atr_len   = input.int(10,    "Supertrend ATR Period")
st_factor = input.float(3.0, "Supertrend Factor",   step=0.1)
don_len   = input.int(20,    "Donchian Period")
sl_pct    = input.float(1.5, "Stop Loss %",   step=0.1) / 100
tp_pct    = input.float(12.0,"Take Profit %", step=0.5) / 100
symbol_id = input.string("LINKUSDT", "Symbol for alert payload")

// ─── SUPERTREND ───────────────────────────────────────────────────────────────
// Pine V5: direction == -1 → uptrend (bullish), direction == 1 → downtrend (bearish)
[st_line, st_dir] = ta.supertrend(st_factor, atr_len)

flip_bull = st_dir == -1 and st_dir[1] == 1    // just flipped to bullish
flip_bear = st_dir == 1  and st_dir[1] == -1   // just flipped to bearish
in_uptrend = st_dir == -1

// ─── DONCHIAN CHANNEL ─────────────────────────────────────────────────────────
don_high = ta.highest(high, don_len)
don_low  = ta.lowest(low,   don_len)
don_mid  = (don_high + don_low) / 2

// ─── SIGNALS ──────────────────────────────────────────────────────────────────
long_cond = flip_bull and close > don_mid
exit_cond = flip_bear or (in_uptrend[1] and st_dir == 1)

// ─── STRATEGY + ALERTS ────────────────────────────────────────────────────────
// TV alert condition: "Any alert() function call"
if long_cond and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    strategy.exit("Long_Exit", "Long",
         loss   = strategy.position_avg_price * sl_pct / syminfo.mintick,
         profit = strategy.position_avg_price * tp_pct / syminfo.mintick)
    alert('{"symbol":"' + symbol_id + '","action":"buy","strategy":"G111_Supertrend_Donchian","timeframe":"4h","price":"' + str.tostring(close) + '","sl_pct":1.5,"tp_pct":12.0,"secret":"{{WEBHOOK_SECRET}}"}', alert.freq_once_per_bar_close)

if exit_cond and strategy.position_size > 0
    strategy.close("Long")
    alert('{"symbol":"' + symbol_id + '","action":"sell","strategy":"G111_Supertrend_Donchian","timeframe":"4h","price":"' + str.tostring(close) + '","sl_pct":1.5,"tp_pct":12.0,"secret":"{{WEBHOOK_SECRET}}"}', alert.freq_once_per_bar_close)

// ─── VISUALS ──────────────────────────────────────────────────────────────────
plot(don_high, "Don High", color.new(color.blue,   60))
plot(don_low,  "Don Low",  color.new(color.blue,   60))
plot(don_mid,  "Don Mid",  color.new(color.purple,  60), style=plot.style_circles)
plot(st_line,  "Supertrend", in_uptrend ? color.new(color.green, 20) : color.new(color.red, 20), linewidth=2)
plotshape(long_cond, "LONG", shape.triangleup,   location.belowbar, color.lime, size=size.small)
plotshape(exit_cond and strategy.position_size > 0, "EXIT", shape.triangledown, location.abovebar, color.red, size=size.small)
