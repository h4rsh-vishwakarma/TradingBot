// v1 2026-04-23
//@version=5
// 
// Aggressive_Entry [Webhook] v3  4H CHART
// 
// WHY 4H: 15m had 1537 trades = -9206% to -9844% on TV
//         4H has  ~96 trades = 0.012%/day fees  very viable
// Entry: RSI + EMA momentum confluence with ATR breakout confirmation
// 
// SYMBOL PARAMS:
//   FILUSDT   Len=14, Mult=2.04
//   LDOUSDT   Len=16, Mult=2.54
//   OPUSDT    Len=12, Mult=2.00
// 
strategy("Aggressive Entry [Webhook] v3  4H", shorttitle="AE-4H",
     overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.06,
     calc_on_order_fills=false, calc_on_every_tick=false)

//  Inputs 
rsi_len  = input.int(14,    "RSI Length",            minval=5,  maxval=30, tooltip="FILUSDT=14, LDOUSDT=16, OPUSDT=12")
atr_mult = input.float(2.04,"ATR Multiplier",        minval=1.0, maxval=5.0, step=0.01, tooltip="FILUSDT=2.04, LDOUSDT=2.54, OPUSDT=2.00")
ema_len  = input.int(21,    "EMA Trend Length",      minval=10, maxval=100)
sl_pct   = input.float(2.0, "Stop Loss %",           minval=0.5, maxval=10.0, step=0.1)
tp_pct   = input.float(6.0, "Take Profit %",         minval=1.0, maxval=20.0, step=0.1)
adx_th   = input.int(20,    "ADX Threshold",         minval=10, maxval=40)
min_gap  = input.int(2,     "Min Bars Between Signals",minval=1, maxval=10, tooltip="2 bars on 4H = 8h minimum gap")

//  Indicators 
rsi14       = ta.rsi(close, rsi_len)
ema21       = ta.ema(close, ema_len)
atr14       = ta.atr(14)
atrMa       = ta.sma(atr14, 100)
atrBreakout = atr14 * atr_mult
[_, _, adx] = ta.dmi(14, 14)

// ATR-based breakout: price moved > atr_multATR from EMA  strong move
bullBreak = close > ema21 + atrBreakout
bearBreak = close < ema21 - atrBreakout

//  Filters 
adxOK = adx > adx_th
volOK = atr14 < 2.5 * atrMa
var int  consec = 0
var int  cdBars = 0
var bool inCool = false
if strategy.closedtrades > 0
    lastPnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    consec  := lastPnl < 0 ? consec + 1 : 0
    if consec >= 3
        inCool := true
        cdBars := 3
        consec := 0
if inCool
    cdBars -= 1
    if cdBars <= 0
        inCool := false
var int lastSigBar = 0
gapOK = bar_index - lastSigBar >= min_gap
allF  = adxOK and volOK and (not inCool) and gapOK

//  Signals 
longCond  = bullBreak and rsi14 > 55 and rsi14 < 80 and allF   // Not overbought
shortCond = bearBreak and rsi14 < 45 and rsi14 > 20 and allF   // Not oversold

//  Execute 
if longCond
    lastSigBar := bar_index
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", loss=close*sl_pct/100, profit=close*tp_pct/100)
if shortCond
    lastSigBar := bar_index
    strategy.entry("Short", strategy.short)
    strategy.exit("XS", "Short", loss=close*sl_pct/100, profit=close*tp_pct/100)

//  Plots 
plot(ema21,         "EMA 21",     color=color.yellow, linewidth=2)
plot(ema21 + atrBreakout, "Bull Zone", color=color.new(color.green,60), linewidth=1)
plot(ema21 - atrBreakout, "Bear Zone", color=color.new(color.red,60),   linewidth=1)
bgcolor(inCool ? color.new(color.orange,90) : na, title="Cooldown")
plotshape(longCond,  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small)
plotshape(shortCond, style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small)

//  Alerts 
alertcondition(longCond,  "LONG 4H", '{"symbol":"{{ticker}}","action":"buy","strategy":"Aggressive_Entry","timeframe":"4h","price":"{{close}}","sl_pct":2.0,"tp_pct":6.0}')
alertcondition(shortCond, "SHORT 4H", '{"symbol":"{{ticker}}","action":"sell","strategy":"Aggressive_Entry","timeframe":"4h","price":"{{close}}","sl_pct":2.0,"tp_pct":6.0}')
